// IELTS Learning OS — Prisma schema（设计产物，可直接 `prisma db push`）
// 目标版本：Prisma 6.x（不要升到 7：v7 强制 driver adapter + prisma.config.ts + ESM）
// 约定：
//   1. 业务日期一律 String "YYYY-MM-DD"（SQLite 无 DATE 类型；字符串字典序可比较可索引）
//   2. 时刻一律 DateTime
//   3. 枚举一律 String，取值由 src/lib/constants.ts + zod 约束（SQLite 不支持原生 enum）
//   4. JSON 一律 String（SQLite 不支持标量数组），统一由 src/lib/json.ts 解析
//   5. 派生值（accuracy/completionRate/netMinutes/overdueDays）不落库，一律读模型计算
//
// v2.0 增量（全部为加法，旧代码 + 新库可直接运行）：
//   · 新增 8 表：LearningGoal / SkillAllocationProfile / GoalMilestone /
//     SkillAssessment / IeltsAssessment / EnglishMediatedSession /
//     LearningOutput / EvidenceAttachment
//   · PlanTask / StudySession / StudyRecord 增加 track + primarySkill 快照
//   · StudySession.taskId 改为可空（媒介学习不挂计划任务）
//   · 三目标分别统计：CEFR 评估、IELTS 成绩、媒介学习里程碑物理分表，互不换算
//
// v2.1 增量（全部为加法 + 两个新状态值，旧数据不需要改写）：
//   · 新增 4 表：DailyBudget / WeeklyTarget / WeeklyDayAllocation / PlanVersion，
//     以及单行配置 PlannerSettings（id 恒为 1）
//   · PlanTask 增加 priority / splittable / minChunkMinutes / planVersion /
//     originalScheduledDate / rescheduleReason / deferReason / sourceKind
//   · 任务状态新增 CANCELLED / DEFERRED（两者都不进入完成率失败分母）
//   · UserProfile.dailyMinutes 降级为「v2.0 历史值」，不再作为 v2.1 预算来源：
//     v2.1 预算一律走 DailyBudget → PlannerSettings.weekdayProfiles →
//     PlannerSettings.defaultDailyMinutes（初始建议值 60，且标记为建议）
//   · 「240 分钟是最低计划时长」的假设作废；15 分钟为应急维护模式

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── E1 单用户配置（固定 1 行，id 恒为 1）
model UserProfile {
  id                Int       @id @default(1)
  targetBandOverall Float     @default(6.5)
  targetBandListen  Float?
  targetBandRead    Float?
  targetBandWrite   Float?
  targetBandSpeak   Float?
  /**
   * v2.0 历史字段。v2.1 起**不再**是每日预算来源（预算见 `DailyBudget` 与 `PlannerSettings`），
   * 仅保留用于旧数据回读与设置页展示「v2.0 旧值」，避免静默把 240 当默认预算。
   */
  dailyMinutes      Int       @default(240)
  timezone          String    @default("Asia/Singapore")
  examDate          String?
  weeklyReviewDow   Int       @default(0)
  aiEnabled         Boolean   @default(false)
  lastExportedAt    DateTime?

  // ── v2.0 三目标全局默认 ──
  /**
   * /**
   * /**
   * /**
   * 长期通用英语目标等级（展示用，非官方认证）。
   */
  cefrTarget        String @default("B2")
  /**
   * 英语媒介学习的默认学科；初始 French，可改。
   */
  mediatedSubject   String @default("French")
  /**
   * 媒介学习的起始强度档：PRE_A2 接触术语 | A2_B1 低强度试学 | B1_PLUS 系统化。
   */
  mediatedStartBand String @default("A2_B1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── E2 阶段（4 行，seed 写入）
model Stage {
  id          String   @id @default(cuid())
  code        String   @unique // S0_PREP|S1_A0_A2|S2_A2_B1|S3_B1_IELTS
  nameZh      String
  estDaysMin  Int
  estDaysMax  Int? // null = 「或更久」
  status      String   @default("NOT_STARTED") // NOT_STARTED|ACTIVE|COMPLETED|SKIPPED
  startedAt   String?
  completedAt String?
  sortOrder   Int      @default(0)
  /**
   * v2.0：阶段 → SOP v2 的 profile_code 映射（PREPARATION / A0_A2 / A2_B1 / B1_B2）。
   * 不改 `code`，避免所有既有引用（constants / 测试 / 页面）全部返工。
   */
  profileCode String? // PREPARATION|A0_A2|A2_B1|B1_B2
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptanceItems StageAcceptanceItem[]
  planTasks       PlanTask[]
  studyRecords    StudyRecord[]
  egiuLessons     EgiuLesson[]
  mistakes        Mistake[]
  sentenceItems   SentenceAnalysis[]

  @@index([status])
  @@index([sortOrder])
}

// ── E3 阶段验收项（每阶段 7 行，seed 写入；定义型子表 → Cascade）
model StageAcceptanceItem {
  id            String   @id @default(cuid())
  stageId       String
  dimension     String // LISTENING|READING|SPEAKING|WRITING|GRAMMAR|VOCAB|SENTENCE
  isRequired    Boolean  @default(true)
  criterionText String // SOP 原文，只读
  myResult      String?
  evidence      String?
  verdict       String   @default("PENDING") // PENDING|PASSED|FAILED
  judgedAt      String?
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, dimension])
  @@index([stageId])
}

// ── E4 计划任务（含实时计时状态；计时以服务端时钟为准）
model PlanTask {
  id              String    @id @default(cuid())
  stageId         String
  planDate        String // YYYY-MM-DD
  module          String // VOCAB_REVIEW|GRAMMAR|LISTENING|READING|SPEAKING|WRITING|SENTENCE|REVIEW_PLAN|EXTENSIVE|MEDIATED|BASELINE_LISTEN|BASELINE_READ|BASELINE_OUTPUT
  skill           String // VOCAB|GRAMMAR|LISTENING|READING|SPEAKING|WRITING|SENTENCE|META|LISTENING_EXT|READING_EXT
  plannedMinutes  Int
  actualMinutes   Int       @default(0) // 快照，真值 = Σ StudySessionDaySplit
  sortOrder       Int       @default(0)
  status          String    @default("TODO") // TODO|IN_PROGRESS|DONE|PARTIAL|MISSED|CANCELLED|DEFERRED
  statusChangedAt DateTime?
  movedFromDate   String?
  movedToDate     String?
  movedCount      Int       @default(0)
  resourceId      String?
  note            String?

  // ── v2.1 自适应计划 ──
  /**
   * /**
   * /**
   * /**
   * 优先级：P0 到期/逾期复习、P1 当前阶段核心、P2 有证据的弱项/目标差距、P3 拓展。
   * 取值固定 `P0`–`P3`（字符串，SQLite 无 enum）。
   */
  priority              String  @default("P1")
  /**
   * 是否允许分段执行（不可拆的完整模考/整篇写作必须为 false）。
   */
  splittable            Boolean @default(false)
  /**
   * 分段的最小块（分钟），低于它不生成碎片任务。
   */
  minChunkMinutes       Int     @default(5)
  /**
   * 生成该任务时的计划版本；重排时递增，历史版本行保留。
   */
  planVersion           Int     @default(1)
  /**
   * 首次被安排到的日期；顺延/重排后不变，用于追溯原始安排。
   */
  originalScheduledDate String?
  /**
   * 最近一次重排原因（预算变更 / P0 挤压 / 手动延后 …）。
   */
  rescheduleReason      String?
  /**
   * 进入 backlog 的原因（如「P0 超额，按风险分批」）。
   */
  deferReason           String?
  /**
   * 任务来源：REVIEW|CORE|WEAKNESS|EXTENDED|MANUAL|LEGACY（v2.0 迁移行 = LEGACY）。
   */
  sourceKind            String  @default("CORE")

  // ── v2.0 三轨道 ──
  /**
   * /**
   * /**
   * /**
   * 主轨道。任务必须归属一个主轨道；允许加标签，但不允许一条学习时长被重复计入总时长。
   * GENERAL_ENGLISH | IELTS_PREPARATION | ENGLISH_MEDIATED_LEARNING
   */
  track        String @default("GENERAL_ENGLISH")
  /**
   * 四技能粒度 + 支持性模块。技能时间统计**只看这个字段**（同一任务只有一个主技能），
   * 与 `skill`（模块粒度，含泛听/泛读/复盘）分离，避免两套口径互相污染。
   * LISTENING | READING | SPEAKING | WRITING | FOUNDATION
   */
  primarySkill String @default("FOUNDATION")

  timerStatus             String    @default("IDLE") // IDLE|RUNNING|PAUSED|STOPPED
  timerStartedAt          DateTime?
  timerAccumulatedSeconds Int       @default(0)
  timerLastActiveAt       DateTime?
  timerVersion            Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── v2.7 溯源（纯加法，可空）────────────────────────────────────────────
  // 为什么放在字段列表末尾：SQLite 的 ALTER TABLE ADD COLUMN 只能追加到末尾，
  // 把新字段写在末尾，schema 顺序与物理列顺序一致（迁移后再 db push 是零变更）。
  /**
   * 生成这条任务时选中的候选（`TaskCandidate.id`）。
   *
   * **普通 String?，不建跨域外键**：v2.7 的新表与既有 110 张表之间刻意不建立
   * 外键关系，避免一次数据层改动把级联删除语义扩散到整个计划域。
   * 溯源靠应用层查询，候选过期后这里只留一个"再也查不到"的 id（可接受）。
   */
  candidateId           String?
  /// JSON：当时的优先级决策快照（factors/score/priority/rationale），可解释性溯源
  decisionJson          String?

  stage                 Stage                       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  resource              Resource?                   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  sessions              StudySession[]
  records               StudyRecord[]
  evidenceRecords       EvidenceRecord[]
  retestSchedules       RetestSchedule[]
  vocabularyAssignments VocabularyAssignment[]
  vocabularySessions    VocabularyPracticeSession[]

  @@index([planDate, sortOrder])
  @@index([stageId])
  @@index([status])
  @@index([timerStatus])
  @@index([resourceId])
  @@index([track])
  @@index([primarySkill])
  @@index([planDate, priority])
  @@index([planVersion])
  @@index([candidateId])
}

// ── v2.1 B1 每日时间预算（同一日期只有一条当前有效预算）
//
// 「预算」是计划净学习时间的**上限**，既不是实际学习时间，也不是打卡要求。
// 0 分钟 = 休息日 / 未安排学习日：不生成强制任务，也不计入完成率失败分母。
model DailyBudget {
  id                      String   @id @default(cuid())
  date                    String   @unique // YYYY-MM-DD
  /**
   * 计划净学习分钟上限（休息日为 0）。
   */
  plannedAvailableMinutes Int      @default(0)
  /**
   * PRESET | CUSTOM | REST_DAY
   */
  budgetType              String   @default("PRESET")
  /**
   * EMERGENCY|MINIMUM|LIGHT|LIGHT_STANDARD|STANDARD|FOCUSED|DEEP|EXTENDED|CUSTOM|REST
   */
  tierCode                String?
  isRestDay               Boolean  @default(false)
  /**
   * 首次安装的 60 分钟建议值必须标记为建议，不得冒充用户真实可用时间。
   */
  isInitialSuggestion     Boolean  @default(false)
  /**
   * USER | WEEKDAY_TEMPLATE | DEFAULT_SUGGESTION | MIGRATION
   */
  source                  String   @default("USER")
  note                    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([date])
  @@index([isRestDay])
}

// ── v2.1 B2 周总学习目标（每周一行，预算与实际分开统计）
model WeeklyTarget {
  id            String   @id @default(cuid())
  weekStart     String   @unique // ISO 周周一 YYYY-MM-DD
  targetMinutes Int
  /**
   * ACTIVE | ADJUSTED
   */
  status        String   @default("ACTIVE")
  /**
   * 建议来源：USER | SUGGESTION_ACCEPTED。系统建议不得自动写入。
   */
  source        String   @default("USER")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations WeeklyDayAllocation[]

  @@index([weekStart])
}

// ── v2.1 B3 周内每日分配（可含休息日；不要求平均分配）
model WeeklyDayAllocation {
  id               String  @id @default(cuid())
  weeklyTargetId   String
  date             String // YYYY-MM-DD
  availableMinutes Int     @default(0)
  isRestDay        Boolean @default(false)

  weeklyTarget WeeklyTarget @relation(fields: [weeklyTargetId], references: [id], onDelete: Cascade)

  @@unique([weeklyTargetId, date])
  @@index([date])
}

// ── v2.1 B4 规划器全局配置（单行，id 恒为 1）
model PlannerSettings {
  id                  Int      @id @default(1)
  /**
   * 未配置任何日程时的**初始建议**每日分钟数（可编辑，不是强制默认）。
   */
  defaultDailyMinutes Int      @default(60)
  /**
   * 周日..周六 7 个值，JSON 数组；null/0 表示休息日。
   */
  weekdayProfiles     String   @default("[60,60,60,60,60,60,0]")
  /**
   * 任务最小时间粒度（分钟），低于此值不创建任务。
   */
  minTaskMinutes      Int      @default(5)
  /**
   * 周目标分钟数；null = 未设置。
   */
  weeklyTargetMinutes Int?
  /**
   * 优先级规则参数 JSON（P0 上限比例、核心最低保障比例等）。
   */
  priorityPolicy      String   @default("{\"p0CapRatio\":0.6,\"coreMinRatio\":0.3}")
  /**
   * 用户是否亲自保存过本配置。false = 仍是迁移写入的初始建议值，不得当作真实可用时间。
   */
  isUserConfirmed     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── v2.1 B5 计划版本（append-only；保存调整前后快照与幂等键）
model PlanVersion {
  id                    String   @id @default(cuid())
  planDate              String
  version               Int
  /**
   * GENERATE | REPLAN | MANUAL_ADJUST
   */
  changeSource          String
  reason                String?
  /**
   * 本次生成/重排使用的有效预算分钟。
   */
  budgetMinutes         Int      @default(0)
  /**
   * 变更发生时的当日已发生净学习分钟（用于校验「事实不被改写」）。
   */
  actualMinutesAtChange Int      @default(0)
  beforeSnapshot        String? // JSON：变更前的任务快照
  afterSnapshot         String? // JSON：变更后的任务快照
  /**
   * 同一生成请求的幂等键；重复请求返回已有结果，不重复建任务。
   */
  idempotencyKey        String?  @unique
  createdAt             DateTime @default(now())

  // ── v2.7 计划层级与失效标记（纯加法，可空）──────────────────────────────
  /// 这次变更是基于哪一份输入快照算出来的（`PlanningSnapshot.id`，普通 String?，不建外键）
  snapshotId            String?
  /**
   * 计划层级（4 值）：DAY | WEEK | MONTH | CYCLE。null 读作 `DAY`
   * （v2.7 之前的数据全是日计划版本）。
   *
   * 用可空 + 读取时回落，而不是加 `@default("DAY")` —— 有了默认值，v2.7 之前的
   * 日计划历史行就会被伪装成「v2.7 新语义写出来的日计划版本」，而它们只是日计划。
   *
   * `MONTH` 是 30 天阶段计划层：`PlanVersion(layer='MONTH', planDate=阶段首日)`，
   * 那 8 项结构（阶段目标 / 4 个周里程碑 / 技能配比 / 每周测试 / 材料建议 /
   * 词汇语法范围 / 验收指标 / 调整条件）存在 `afterSnapshot` 里。
   * **`WeeklyFocus` 是周度反思记录（focusQuestion / inputText / outputText /
   * feedbackText），与计划层级无关，不得混用** —— 它装不下那 8 项，也没有区间语义。
   * 区间不落列：由纯函数 `periodOf()` 按 layer 派生（DAY→当天、WEEK→+6、
   * MONTH→+29、CYCLE→+89）。
   */
  layer                 String?
  /**
   * 上层版本的来源（自引用，普通 String?，不建外键）。
   *
   * 只允许指**上一层**：`DAY→WEEK` / `WEEK→MONTH` / `MONTH→CYCLE`。
   * 禁止父级指向自己的子级（那会让"这份版本基于什么算出来"失去方向）。
   */
  parentVersionId       String?
  /// 上游变化导致这份版本不再可直接执行的时间点（null = 仍然有效）
  staleAt               DateTime?
  /// 失效原因（人话：预算变更 / 候选过期 / 上游版本被替换 …）
  staleReason           String?

  @@unique([planDate, version])
  @@index([planDate])
  @@index([snapshotId])
}

// ── E5 计时段（append-only；一 task 可多段）
//
// v2.0 关键改动：`taskId` 由必填改为可空。
// 原因：英语媒介学习允许不经过「计划任务」直接记录一次学习（SOP §7.2），
// 但它仍必须落在这张表里，才能保证「总净时长 = Σ DaySplit」这条唯一口径不破。
// 若为它另建带 duration 的表，然后汇总时再相加，就是双重计时。
model StudySession {
  id               String   @id @default(cuid())
  taskId           String?
  startedAt        DateTime
  endedAt          DateTime
  activeMinutes    Int
  idleMinutes      Int      @default(0)
  countRatio       Float    @default(0) // clamp(active/planned, 0, 1.5)
  anomalyFlag      Boolean  @default(false)
  anomalyReason    String?
  terminatedReason String // COMPLETED|PAUSED|ABANDONED|MOVED|TIMEOUT
  sessionDate      String // 占比最大的自然日

  // ── v2.0：轨道与主技能快照（聚合不再必须 join task，task 可空时也能归集） ──
  track      String  @default("GENERAL_ENGLISH")
  /**
   * LISTENING | READING | SPEAKING | WRITING | FOUNDATION
   */
  skill      String  @default("FOUNDATION")
  /**
   * 若本段来自英语媒介学习，指向那条记录（1:1 反向）。
   */
  mediatedId String?

  createdAt DateTime @default(now())

  task               PlanTask?                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mediated           EnglishMediatedSession?     @relation(fields: [mediatedId], references: [id], onDelete: SetNull)
  daySplits          StudySessionDaySplit[]
  evidenceRecords    EvidenceRecord[]
  vocabularySessions VocabularyPracticeSession[]

  @@index([taskId])
  @@index([sessionDate])
  @@index([track])
  @@index([skill])
  @@index([mediatedId])
}

// 跨零点分钟占比拆分 → 保证「日净时长」不虚高（日净时长只从这张表求和）
model StudySessionDaySplit {
  id        String @id @default(cuid())
  sessionId String
  date      String
  minutes   Int

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, date])
  @@index([date])
}

// ── E6 学习记录（核心，软删除）
model StudyRecord {
  id               String  @id @default(cuid())
  stageId          String
  taskId           String?
  recordDate       String
  skill            String
  resourceId       String?
  chapter          String?
  content          String
  plannedMinutes   Int     @default(0)
  actualMinutes    Int     @default(0)
  status           String  @default("DONE")
  totalQuestions   Int     @default(0)
  correctQuestions Int     @default(0)
  difficulty       String? // EASY|MEDIUM|HARD
  outputText       String? // G2 可检查产出
  problemText      String?
  errorTypes       String? // JSON string[]
  nextReviewDate   String?
  ext              String? // JSON，分科扩展（听力6/阅读6/口语8/写作7）

  // ── v2.0 三轨道 ──
  track        String @default("GENERAL_ENGLISH")
  /**
   * 四技能粒度快照（LISTENING|READING|SPEAKING|WRITING|FOUNDATION）。
   */
  primarySkill String @default("FOUNDATION")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  stage         Stage              @relation(fields: [stageId], references: [id], onDelete: Restrict)
  task          PlanTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  resource      Resource?          @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  mistakes      Mistake[]
  sentenceItems SentenceAnalysis[]
  revisions     RecordRevision[]
  outputs       LearningOutput[]

  @@index([recordDate])
  @@index([skill, recordDate])
  @@index([stageId])
  @@index([archivedAt])
  @@index([resourceId])
  @@index([track])
}

// ── P1-03 字段级修订历史（append-only）
model RecordRevision {
  id          String   @id @default(cuid())
  recordId    String
  field       String
  beforeValue String?
  afterValue  String?
  changedAt   DateTime @default(now())

  record StudyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, changedAt])
}

// ── E7 EGIU 单元（只存当前态；历史在 EgiuReview）
model EgiuLesson {
  id             String    @id @default(cuid())
  stageId        String
  resourceId     String?
  book           String    @default("Essential Grammar in Use")
  version        String?
  unitNo         String
  knowledgePoint String
  currentColor   String    @default("PENDING") // PENDING|GREEN|YELLOW|RED（= 最近一次有效判定）
  currentScore   Float?
  currentReason  String?
  learnedDate    String // D0，复习点起算日（补录时为 user 填的学习日）
  greenStreak    Int       @default(0)
  masteredAt     DateTime?
  inLowFreqPool  Boolean   @default(false)
  nextReviewDate String?
  retestCount    Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stage    Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  resource Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  reviews  EgiuReview[]

  @@index([stageId])
  @@index([currentColor])
  @@index([nextReviewDate])
  @@index([resourceId, unitNo])
}

// ── E8 复测记录（append-only，禁止覆盖；UI 无 update/delete 入口）
model EgiuReview {
  id               String   @id @default(cuid())
  lessonId         String
  reviewDate       String
  reviewStage      String // D0|D1|D3|D7|D14|D21|D30|MANUAL
  totalQuestions   Int
  correctQuestions Int
  explainOk        Boolean
  sentencesCount   Int
  coreRuleOk       Boolean
  judgedColor      String
  judgeReason      String // 命中规则，UI 必须原样展示
  judgeBranch      String // ZERO|OVERRIDE|FULL|LOW_VOLUME
  score            Float? // 仅 LOW_VOLUME 分支的 S
  errorBreakdown   String? // JSON {rule_unclear,memory_confusion,careless,vocab}
  reviewTaskId     String?
  createdAt        DateTime @default(now())

  lesson EgiuLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, reviewDate])
  @@index([reviewDate])
}

// ── E9 错题（软删除）
model Mistake {
  id                 String    @id @default(cuid())
  stageId            String
  sourceType         String // EGIU_REVIEW|STUDY_RECORD|MANUAL|VOCAB
  sourceId           String?
  studyRecordId      String?
  originalQuestion   String
  myAnswer           String?
  correctAnswer      String
  errorReason        String
  knowledgePoint     String // 薄弱点聚合键
  errorCategory      String // RULE_NOT_UNDERSTOOD|MEMORY_CONFUSION|VOCAB_UNKNOWN|WORD_ORDER|CARELESS|OTHER
  ieltsErrorCategory String? // VOCAB|LOCATING|COMPREHENSION|ATTENTION|STRATEGY（仅 S3）
  reviewCount        Int       @default(0)
  lastReviewAt       String?
  nextReviewAt       String?
  isMastered         Boolean   @default(false)
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  stage       Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  studyRecord StudyRecord? @relation(fields: [studyRecordId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([knowledgePoint])
  @@index([errorCategory])
  @@index([isMastered])
  @@index([nextReviewAt])
}

// ── E10 统一复习调度（唯一入口，4 种 targetType 共用，禁止为各类型另建调度器）
model ReviewTask {
  id             String    @id @default(cuid())
  targetType     String // EGIU_LESSON|MISTAKE|VOCAB_WORD|GRAMMAR_POINT
  targetId       String
  targetLabel    String // 冗余展示名，避免多态 join / N+1
  knowledgePoint String?
  intervalCode   String // D1|D3|D7|D14|D21|D30|MANUAL|LOW_FREQ_30
  dueDate        String
  status         String    @default("PENDING") // PENDING|DONE|SKIPPED|SUPERSEDED
  estMinutes     Int       @default(5)
  result         String? // PASS|FAIL（status=DONE 时必填）
  completedAt    DateTime?
  skippedReason  String?
  supersededById String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([targetType, targetId, intervalCode, dueDate])
  @@index([status, dueDate])
  @@index([targetType, targetId])
  @@index([dueDate])
}

// ── E11 词汇（软删除；三档掌握度不可合并统计）
model VocabWord {
  id              String    @id @default(cuid())
  word            String    @unique
  phonetic        String?
  partOfSpeech    String?
  meaningZh       String
  meaningEn       String?
  collocation     String?
  exampleSentence String?
  source          String    @default("MANUAL") // Oxford3000|MANUAL
  learnedDate     String
  mastery         String    @default("RECOGNIZE_ONLY") // RECOGNIZE_ONLY|COMPREHEND|ACTIVE_USE
  lastReviewAt    String?
  nextReviewAt    String?
  isNew           Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quizItems VocabQuizItem[]

  @@index([learnedDate])
  @@index([mastery])
  @@index([archivedAt])
  @@index([nextReviewAt])
}

// 随机抽测会话（append-only）
model VocabQuiz {
  id               String   @id @default(cuid())
  quizDate         String
  sampleSize       Int
  weightedAccuracy Float? // Σ权重 / 词数；样本 0 → null
  recommendation   String?
  createdAt        DateTime @default(now())

  items VocabQuizItem[]

  @@index([quizDate])
}

model VocabQuizItem {
  id         String  @id @default(cuid())
  quizId     String
  wordId     String?
  word       String
  selfRating String // RECOGNIZE_ONLY|COMPREHEND|ACTIVE_USE
  weight     Float // 0.3 | 0.7 | 1.0

  quiz    VocabQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  wordRef VocabWord? @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([quizId])
}

// ── E12 句子成分（component 与 pos 两个独立取值集，不可复用同一字段）
model SentenceAnalysis {
  id             String    @id @default(cuid())
  stageId        String
  sentenceEn     String
  sentenceZh     String?
  tokens         String // JSON [{text,component,pos}]
  isCorrect      Boolean   @default(true)
  errorReason    String? // isCorrect=false 时必填（应用层校验）
  patternTag     String? // FIVE_PATTERNS|RELATIVE_CLAUSE|ADVERBIAL_CLAUSE|NON_FINITE|PASSIVE
  sourceRecordId String?
  sentenceDate   String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stage        Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sourceRecord StudyRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([sentenceDate])
}

// ── E13 周复盘（(isoYear, isoWeek) 唯一）
model WeeklyReview {
  id             String    @id @default(cuid())
  isoYear        Int
  isoWeek        Int
  weekStart      String // 周一
  weekEnd        String // 周日
  metrics        String // JSON：13 项 {auto, override, overriddenAt}
  isPartial      Boolean   @default(false)
  top3Weaknesses String // JSON 固定 3 项 [{name,score,evidence,manual}]
  reviewNote     String?
  exportedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([isoYear, isoWeek])
  @@index([weekStart])
}

// ── E14 资源库（8 类初始资源由 seed 写入；代码内禁止出现资源名枚举）
model Resource {
  id               String    @id @default(cuid())
  name             String
  subject          String // GRAMMAR|VOCAB|PRONUNCIATION|LISTENING|READING|SPEAKING|WRITING|EXAM
  type             String // BOOK|WORDLIST|WEBSITE|AUDIO_SERIES|GRADED_READER|EXAM_PAPER
  applicableStages String    @default("[\"S1\"]") // JSON string[]
  version          String?
  totalUnits       Int?
  currentUnit      Int?
  startDate        String?
  finishDate       String?
  url              String?
  note             String?
  isPrimary        Boolean   @default(false) // SOP：每项能力固定一个主材料
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  planTasks    PlanTask[]
  studyRecords StudyRecord[]
  egiuLessons  EgiuLesson[]
  /// v2.6 虚拟反向关系（来自 LearningMaterial.resourceId，**不产生列/索引**）
  materials    LearningMaterial[]

  @@index([subject])
  @@index([archivedAt])
}

// ── 辅助：阶段流转日志（append-only，只增不删）
model StageTransitionLog {
  id               String   @id @default(cuid())
  fromStageCode    String?
  toStageCode      String
  decidedAt        DateTime @default(now())
  decidedBy        String // SYSTEM_SUGGESTED|USER
  reason           String
  evidenceSnapshot String? // JSON
}

// ── 辅助：当日总结
model DailySummary {
  id                    String   @id @default(cuid())
  summaryDate           String   @unique
  netMinutes            Int      @default(0)
  completionRateByTime  Float?
  completionRateByCount Float?
  outputs               String? // JSON
  issues                String? // JSON
  draftText             String?
  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ── P1-07 AI 建议（与学习成绩物理分区，UI 强制展示 basis）
model AiSuggestion {
  id        String   @id @default(cuid())
  scope     String // WEEKLY|WEAKNESS|PLAN
  refKey    String?
  status    String   @default("unavailable") // available|unavailable
  title     String
  body      String
  basis     String? // 依据
  provider  String?
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.0 三轨道模型
// ══════════════════════════════════════════════════════════════════════════════
//
// 三条轨道必须分别统计、分别验收，**不生成混合「总能力分」**。
// CEFR 估计（SkillAssessment）、IELTS 成绩（IeltsAssessment）与媒介学习里程碑
// （GoalMilestone + EnglishMediatedSession）物理分表存储，代码层面也不提供互相换算。

// ── V1 学习目标（三类各一行：GENERAL_ENGLISH / IELTS / ENGLISH_MEDIATED_LEARNING）
model LearningGoal {
  id           String   @id @default(cuid())
  /**
   * GENERAL_ENGLISH | IELTS | ENGLISH_MEDIATED_LEARNING
   */
  goalType     String   @unique
  name         String
  /**
   * 目标值：通用英语为 CEFR 等级（B2）；IELTS 为总分（6.5）；媒介学习为里程碑数或等级描述。
   */
  targetValue  String?
  /**
   * 雅思单项最低分（仅 IELTS 目标使用；其余为 null）。
   */
  minListening Float?
  minReading   Float?
  minWriting   Float?
  minSpeaking  Float?
  targetDate   String? // YYYY-MM-DD，可空
  /**
   * ACTIVE | ACHIEVED | PAUSED
   */
  status       String   @default("ACTIVE")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  milestones GoalMilestone[]

  @@index([status])
  @@index([goalType])
}

// ── V2 四技能配比（阶段级，可追溯：改配置=插新行 + 旧行 isActive=false）
model SkillAllocationProfile {
  id            String   @id @default(cuid())
  /**
   * PREPARATION | A0_A2 | A2_B1 | B1_B2 | IELTS_INTENSIVE
   */
  profileCode   String
  /**
   * GENERAL_ENGLISH | IELTS_PREPARATION（IELTS_INTENSIVE 专用）
   */
  track         String   @default("GENERAL_ENGLISH")
  listeningPct  Int
  readingPct    Int
  speakingPct   Int
  writingPct    Int
  effectiveFrom String // YYYY-MM-DD
  isActive      Boolean  @default(true)
  /**
   * 变更原因（审计要求：权重修改必须留痕）。
   */
  changeReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileCode, isActive])
  @@index([track, isActive])
}

// ── V3 目标里程碑（每个目标自己的，不与其他目标共享完成状态）
model GoalMilestone {
  id            String    @id @default(cuid())
  goalId        String
  /**
   * 稳定编码，用于去重与幂等 seed（如 GE_A2_EXIT / IELTS_BAND_6_5 / MEDIATED_FRENCH_BASICS）
   */
  milestoneCode String
  title         String
  description   String?
  /**
   * 目标阈值（数字或等级文本，展示用）。
   */
  target        String?
  /**
   * PENDING | ACHIEVED | FAILED
   */
  status        String    @default("PENDING")
  completedAt   DateTime?
  /**
   * 证据 ID 列表（JSON string[]，指向 SkillAssessment / IeltsAssessment / EnglishMediatedSession / LearningOutput）。
   */
  evidenceIds   String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  goal LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, milestoneCode])
  @@index([goalId, status])
}

// ── V4 CEFR 能力评估（按技能独立；学习时长不得推断等级）
model SkillAssessment {
  id             String   @id @default(cuid())
  /**
   * LISTENING | READING | SPEAKING | WRITING
   */
  skill          String
  /**
   * 估计等级：A1|A2|B1|B2|C1（个人能力估计，**不是官方认证**）。
   */
  cefrLevel      String
  /**
   * SELF | TEST | EXTERNAL | AI_ESTIMATE
   */
  assessmentType String
  /**
   * 分数或量表描述（自由文本，便于填「雅思听力 6.0」「教师反馈 B1+」）。
   */
  score          String?
  assessDate     String // YYYY-MM-DD
  /**
   * SELF | TEACHER | EXAM | AI | OTHER
   */
  assessor       String   @default("SELF")
  /**
   * 1..5 置信度（样本量/来源可靠性）。
   */
  confidence     Int      @default(3)
  evidenceId     String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([skill, assessDate])
  @@index([cefrLevel])
  @@index([assessmentType])
}

// ── V5 IELTS 成绩（正式考试与模考同表，靠 testType 区分；**不参与 CEFR 计算**）
model IeltsAssessment {
  id            String   @id @default(cuid())
  testDate      String // YYYY-MM-DD
  /**
   * OFFICIAL（正式考试）| MOCK（模考）| PRACTICE（单项练习）
   */
  testType      String
  overallBand   Float
  listeningBand Float?
  readingBand   Float?
  writingBand   Float?
  speakingBand  Float?
  /**
   * 来源：Cambridge IELTS 19 Test 2 / BC 官方 / 机构模考 …
   */
  source        String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([testDate])
  @@index([testType])
}

// ── V6 英语媒介学习记录（通过英语学法语等新知识）
//
// 定位：这是**跨技能应用**，不是第五项语言技能。
// `primarySkill` 必须是四项之一；时长落在 `StudySession`（同一条时长只计一次），
// 本表的 `durationMinutes` 只是「这条记录声称的时长」，与 session 交叉校验，
// **绝不参与任何总量求和**。
model EnglishMediatedSession {
  id                    String   @id @default(cuid())
  sessionDate           String // YYYY-MM-DD
  /**
   * 所学学科，初始 French，可扩展为任意主题。
   */
  subject               String   @default("French")
  /**
   * 具体主题：French present tense / French articles …
   */
  topic                 String
  /**
   * 英文材料标题与链接（课程/视频/教材）。
   */
  sourceTitle           String?
  sourceUrl             String?
  /**
   * COURSE | VIDEO | TEXTBOOK | ARTICLE | PODCAST | OTHER
   */
  sourceType            String   @default("COURSE")
  /**
   * 四技能之一：本段学习主要锻炼哪项语言技能。
   */
  primarySkill          String
  /**
   * 记录的时长（分钟）；真值以 StudySession 为准，本字段用于表内自洽校验。
   */
  durationMinutes       Int
  /**
   * 材料语言难度自评：A2 | B1 | B2 | C1
   */
  languageLevel         String?
  /**
   * 理解情况：FULL（能说出主旨与例子）| PARTIAL（需字幕/翻译）| LOW（无法理解）
   */
  understanding         String
  /**
   * 翻译依赖：NONE | SUBTITLE_EN | ZH_ASSIST | HEAVY_ZH
   */
  translationDependency String
  /**
   * 英文笔记（正文）。
   */
  notesEn               String?
  /**
   * 英文摘要（80–120 词级别的产出）。
   */
  summaryEn             String?
  /**
   * 提出的问题（英文）。
   */
  questionsEn           String?
  /**
   * A2_B1 试学 / B1_PLUS 系统化 —— 用于判断阶段强度是否达标。
   */
  intensity             String   @default("A2_B1")
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sessions        StudySession[]
  outputs         LearningOutput[]
  evidenceRecords EvidenceRecord[]

  @@index([sessionDate])
  @@index([subject])
  @@index([primarySkill])
  @@index([understanding])
  @@index([translationDependency])
}

// ── V7 学习产出（英文笔记/摘要/问题/录音/写作；可挂 record 或 mediated session）
model LearningOutput {
  id           String   @id @default(cuid())
  /**
   * 二选一挂载（应用层校验至少一个非空）。
   */
  recordId     String?
  mediatedId   String?
  /**
   * NOTE_EN | SUMMARY_EN | QUESTION_EN | ESSAY | RECORDING | MINDMAP
   */
  outputType   String
  /**
   * 正文（文本类产出）；文件类产出走 `uri`。
   */
  content      String?
  uri          String?
  /**
   * DRAFT | REVIEWED | ACCEPTED
   */
  reviewStatus String   @default("DRAFT")
  createdAt    DateTime @default(now())

  record   StudyRecord?            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  mediated EnglishMediatedSession? @relation(fields: [mediatedId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([mediatedId])
  @@index([outputType])
}

// ── V8 证据附件（录音/写作/评分单/课程材料的元数据；不存二进制）
model EvidenceAttachment {
  id           String  @id @default(cuid())
  fileUri      String
  mimeType     String?
  /**
   * RECORDING | WRITING | SCORE_SHEET | COURSE_MATERIAL | SCREENSHOT | OTHER
   */
  evidenceType String
  /**
   * 多态挂载：SKILL_ASSESSMENT | IELTS_ASSESSMENT | MEDIATED_SESSION | STUDY_RECORD | GOAL_MILESTONE | EVIDENCE_RECORD
   */
  linkedEntity String
  linkedId     String
  note         String?

  // ── v2.2：附件元数据补全（默认私有 + 外发需同意） ──
  sizeBytes     Int?
  checksum      String?
  /**
   * PRIVATE | SHAREABLE | METADATA_ONLY
   */
  privacyLevel  String  @default("PRIVATE")
  /**
   * NOT_REQUIRED | GRANTED | DENIED（第三方 AI/云存储外发同意状态）
   */
  consentStatus String  @default("NOT_REQUIRED")

  createdAt DateTime @default(now())

  evidenceRecords EvidenceRecord[]

  @@index([linkedEntity, linkedId])
  @@index([evidenceType])
  @@index([privacyLevel])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.2 Evidence-Based Learning（全部为加法；不改既有表结构与数据）
// ══════════════════════════════════════════════════════════════════════════════

// ── EV1 证据记录（统一证据模型；原始样本不可覆盖，版本用 parentEvidenceId 串联）
model EvidenceRecord {
  id               String    @id @default(cuid())
  /**
   * LISTENING | READING | SPEAKING | WRITING | GRAMMAR | VOCABULARY
   */
  skill            String
  /**
   * BASELINE | ASSISTED | IMMEDIATE_RETEST | DELAYED_RETEST | APPLIED_TASK | TRANSFER
   */
  evidenceType     String
  /**
   * QUICK | STANDARD | FULL
   */
  level            String    @default("QUICK")
  /**
   * 版本链：指向同链上一版本；链根（BASELINE / 独立 Quick 记录）为 null。
   */
  parentEvidenceId String?
  /**
   * 链根 ID（冗余便于整链查询；由应用层维护，链根记录也为 null）。
   */
  chainRootId      String?
  taskId           String?
  sessionId        String?
  mediatedId       String?
  artifactId       String?
  /**
   * v2.4：关联的 AI 学习会话。删除会话时置空，证据本身保留。
   */
  aiSessionId      String?
  /**
   * 任务与条件快照 JSON：prompt / materialSource / timeLimitMinutes / toolsAllowed / audience / environment
   */
  conditionJson    String?
  /**
   * 可见产出正文（Quick Evidence 可只填这一项）。
   */
  outputText       String?
  /**
   * 内部 0–2 评分：0 未完成/无证据；1 部分/依赖提示/不稳定；2 标明条件下独立完成。
   */
  score            Int?
  scoreReason      String?
  /**
   * 评分维度 JSON（如 { recognition, explanation, controlledUse, independentUse }）。
   */
  dimensionsJson   String?
  /**
   * 证据位置：句子 / 段落 / 音频时间戳 / 题号。
   */
  evidenceAnchor   String?
  /**
   * A0–A4（A0 无辅助；A4 代写/代答，绝不计为独立产出）。
   */
  assistanceLevel  String    @default("A0")
  /**
   * SELF | TEACHER | PEER | AI | EXAM
   */
  assessorType     String    @default("SELF")
  /**
   * LOW | MEDIUM | HIGH
   */
  confidence       String    @default("MEDIUM")
  /**
   * PRIVATE | SHAREABLE | METADATA_ONLY
   */
  privacyLevel     String    @default("PRIVATE")
  note             String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parent   EvidenceRecord?  @relation("EvidenceChain", fields: [parentEvidenceId], references: [id], onDelete: SetNull)
  children EvidenceRecord[] @relation("EvidenceChain")

  task      PlanTask?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  session   StudySession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  mediated  EnglishMediatedSession? @relation(fields: [mediatedId], references: [id], onDelete: SetNull)
  artifact  EvidenceAttachment?     @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  aiSession AILearningSession?      @relation(fields: [aiSessionId], references: [id], onDelete: SetNull)

  diagnoses         BarrierDiagnosis[]
  interventionsPre  InterventionPlan[]       @relation("InterventionPre")
  interventionsPost InterventionPlan[]       @relation("InterventionPost")
  retests           RetestSchedule[]         @relation("RetestParent")
  completedRetests  RetestSchedule[]         @relation("RetestCompleted")
  aiUsage           AIUsageRecord[]          @relation("AIUsageEvidence")
  aiUsageBefore     AIUsageRecord[]          @relation("AIUsageBefore")
  aiUsageAfter      AIUsageRecord[]          @relation("AIUsageAfter")
  vocabularyLinks   VocabularyEvidenceLink[]
  diagnosticAttempt DiagnosticAttempt?       @relation("DiagnosticEvidence")

  @@index([skill, evidenceType])
  @@index([parentEvidenceId])
  @@index([chainRootId])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([privacyLevel])
  @@index([aiSessionId])
}

// ── EV2 分项能力画像（每技能一行；不做四项平均，也不换算 CEFR 官方等级）
model SkillProfile {
  id             String   @id @default(cuid())
  /**
   * LISTENING | READING | SPEAKING | WRITING
   */
  skill          String   @unique
  /**
   * Pre-A1 | A1 | A2 | B1 | B2 | C1；null = 待评估
   */
  direction      String?
  /**
   * LOW | MEDIUM | HIGH
   */
  confidence     String   @default("LOW")
  /**
   * JSON string[]：EvidenceRecord ID 列表（证据依据）
   */
  evidenceBasis  String?
  lastAssessedAt String?
  reviewDueAt    String?
  /**
   * 本次证据不能说明什么（明确边界）。
   */
  doNotInfer     String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── EV3 障碍诊断（按技能的错误类型 + 样本锚点；每轮只聚焦一个主障碍）
model BarrierDiagnosis {
  id             String    @id @default(cuid())
  skill          String
  /**
   * 取值由 BARRIER_TYPES_BY_SKILL 约束（见 constants）
   */
  barrierType    String
  evidenceId     String?
  /**
   * 样本位置：句子 / 段落 / 时间戳 / 题号
   */
  evidenceAnchor String?
  impact         String
  confidence     String    @default("MEDIUM")
  selectedFocus  Boolean   @default(false)
  /**
   * ACTIVE | RESOLVED | SUPERSEDED
   */
  status         String    @default("ACTIVE")
  cycleId        String?
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  evidence      EvidenceRecord?    @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  cycle         LearningCycle?     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  interventions InterventionPlan[]

  @@index([skill, selectedFocus])
  @@index([cycleId])
  @@index([status])
}

// ── EV4 定向修复计划（一条主障碍 → 若干修复任务 + 成功标准 + 前后样本）
model InterventionPlan {
  id               String   @id @default(cuid())
  barrierId        String
  action           String
  successCriteria  String
  /**
   * A0–A4：修复时允许的支架级别；复测时必须撤除
   */
  scaffoldLevel    String   @default("A1")
  estimatedMinutes Int      @default(15)
  /**
   * PLANNED | IN_PROGRESS | COMPLETED | ABANDONED
   */
  status           String   @default("PLANNED")
  preEvidenceId    String?
  postEvidenceId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  barrier      BarrierDiagnosis @relation(fields: [barrierId], references: [id], onDelete: Cascade)
  preEvidence  EvidenceRecord?  @relation("InterventionPre", fields: [preEvidenceId], references: [id], onDelete: SetNull)
  postEvidence EvidenceRecord?  @relation("InterventionPost", fields: [postEvidenceId], references: [id], onDelete: SetNull)

  @@index([barrierId, status])
  @@index([status])
}

// ── EV5 技能型复测调度（知识型复习仍用 ReviewTask，两套状态互不复用）
model RetestSchedule {
  id                  String    @id @default(cuid())
  parentEvidenceId    String
  /**
   * IMMEDIATE | DELAYED | APPLIED | TRANSFER
   */
  retestType          String
  dueDate             String
  /**
   * PENDING | DONE | SKIPPED | SUPERSEDED
   */
  status              String    @default("PENDING")
  estMinutes          Int       @default(10)
  completedEvidenceId String?
  planTaskId          String?
  /**
   * 幂等键：parent + type + dueDate，重复生成返回已有行
   */
  idempotencyKey      String    @unique
  note                String?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parent    EvidenceRecord  @relation("RetestParent", fields: [parentEvidenceId], references: [id], onDelete: Cascade)
  completed EvidenceRecord? @relation("RetestCompleted", fields: [completedEvidenceId], references: [id], onDelete: SetNull)
  planTask  PlanTask?       @relation(fields: [planTaskId], references: [id], onDelete: SetNull)

  @@unique([parentEvidenceId, retestType, dueDate])
  @@index([status, dueDate])
  @@index([parentEvidenceId])
}

// ── EV6 90 天学习周期（1–14 校准 / 15–56 积累 / 57–90 交付；中断可暂停恢复）
model LearningCycle {
  id           String    @id @default(cuid())
  title        String
  goal         String
  deliverable  String?
  startDate    String
  endDate      String
  /**
   * CALIBRATION | BUILD | DELIVER | COMPLETED | PAUSED
   */
  status       String    @default("CALIBRATION")
  /**
   * JSON string[]：基线证据 ID 列表
   */
  baselineRefs String?
  /**
   * 中断恢复记录（客观原因 + 缩小后的下一步，不堆任务）
   */
  recoveryNote String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── v2.7 周期主题与阶段切换留痕（纯加法，可空）────────────────────────
  /// 本周期唯一主主题（90 天周期：1 个主主题 + 至多 2 个次主题）
  primaryTheme         String?
  /// JSON string[]：次主题（≤2 条；与主主题一起构成"这 90 天在练什么"）
  secondaryThemesJson  String?
  /// 最近一次 phase 切换（CALIBRATION→BUILD→DELIVER）的时间点，用于中途校准留痕
  phaseChangedAt       DateTime?

  weeklyFocus WeeklyFocus[]
  diagnoses   BarrierDiagnosis[]

  @@index([status, startDate])
}

// ── EV7 每周主问题（一个周期内每周一行；一个输入 / 一项输出 / 一次反馈 / 一项迁移证据）
model WeeklyFocus {
  id                 String   @id @default(cuid())
  cycleId            String
  weekIndex          Int
  weekStart          String
  focusQuestion      String
  inputText          String?
  outputText         String?
  feedbackText       String?
  transferEvidenceId String?
  nextDecision       String?
  /**
   * OPEN | REVIEWED
   */
  status             String   @default("OPEN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cycle LearningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, weekIndex])
  @@index([weekStart])
}

// ── EV8 AI 使用日志（辅助级别 A0–A4；A4 绝不计为独立产出）
model AIUsageRecord {
  id                String   @id @default(cuid())
  evidenceId        String?
  beforeEvidenceId  String?
  afterEvidenceId   String?
  toolName          String
  modelVersion      String?
  /**
   * A0 | A1 | A2 | A3 | A4
   */
  assistanceLevel   String
  /**
   * HINT | EXPLAIN | CORRECT | REWRITE | GENERATE | SCORE | TRANSLATE | OTHER
   */
  actionType        String
  purpose           String?
  inputRef          String?
  outputRef         String?
  /**
   * ADOPTED | PARTIAL | REJECTED
   */
  adoptedOrRejected String   @default("ADOPTED")
  userNote          String?
  createdAt         DateTime @default(now())

  evidence       EvidenceRecord? @relation("AIUsageEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  beforeEvidence EvidenceRecord? @relation("AIUsageBefore", fields: [beforeEvidenceId], references: [id], onDelete: SetNull)
  afterEvidence  EvidenceRecord? @relation("AIUsageAfter", fields: [afterEvidenceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([assistanceLevel])
  @@index([evidenceId])
}

// ── EV9 方法论资料库（外部资源仅存元数据 + 链接 + 用户自己的笔记；不复制正文）
model ResourceReference {
  id            String   @id @default(cuid())
  title         String
  creator       String?
  url           String   @unique
  /**
   * REPO | ARTICLE | TEMPLATE | GUIDE
   */
  resourceType  String   @default("ARTICLE")
  /**
   * P0 | P1 | P2
   */
  priority      String   @default("P1")
  /**
   * 页面显示的更新时间（可获得时）；无法获得则为 null
   */
  sourceUpdated String?
  accessedAt    String?
  /**
   * 许可说明（如 CC BY-NC 4.0 正文 / MIT 站点代码）
   */
  licenseNote   String?
  /**
   * JSON string[]：适用阶段，如 ["A0_A2","A2_B1"]
   */
  stageFit      String?
  /**
   * ACTIVE | ARCHIVED
   */
  status        String   @default("ACTIVE")
  /**
   * 分类：入口 | 诊断 | 证据 | 复盘 | AI | 工具
   */
  category      String?
  /**
   * 用户自己的摘要（不复制原文）
   */
  summary       String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  readingLogs ResourceReadingLog[]

  @@index([priority, sortOrder])
  @@index([status])
}

// ── EV10 资源阅读日志（每资源一行当前状态；个人摘要 + 计划实践 + 关联证据）
model ResourceReadingLog {
  id                String   @id @default(cuid())
  resourceId        String   @unique
  /**
   * NOT_STARTED | READING | SUMMARIZED | APPLIED | DONE
   */
  status            String   @default("NOT_STARTED")
  personalSummary   String?
  plannedAction     String?
  appliedEvidenceId String?
  lastReadAt        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resource ResourceReference @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ── EV11 应用迁移版本表（版本化迁移脚本写入；db push 建库时为空）
model AppMigration {
  id        String   @id @default(cuid())
  version   String   @unique
  checksum  String?
  appliedAt DateTime @default(now())
  note      String?
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.3 Vocabulary / TypeWords Integration（全部为加法；既有 VocabWord 保持不变）
// ══════════════════════════════════════════════════════════════════════════════

// ── V1 词汇来源（每个词表/教材/个人来源都要能追溯许可） ──
model VocabularySource {
  id         String    @id @default(cuid())
  /**
   * TEXTBOOK | EXAM | MATERIAL | MANUAL | IMPORT | LEGACY
   */
  sourceType String    @default("IMPORT")
  title      String
  edition    String?
  license    String?
  licenseUrl String?
  url        String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items       VocabularyItem[]
  memberships VocabularyItemSource[]
  decks       VocabularyDeck[]

  @@index([sourceType])
  @@index([archivedAt])
}

// ── V2 统一词条（lemma + POS + senseKey 才唯一；同形异义不合并） ──
model VocabularyItem {
  id               String    @id @default(cuid())
  lemma            String
  displayForm      String?
  normalizedLemma  String
  /**
   * 空串 = 词性未知；不用 NULL，保证 SQLite 唯一约束可生效。
   */
  pos              String    @default("")
  language         String    @default("en")
  /**
   * 同形异义的稳定区分键；默认 default。
   */
  senseKey         String    @default("default")
  phoneticUk       String?
  phoneticUs       String?
  definitionZh     String?
  definitionEn     String?
  examplesJson     String?
  collocationsJson String?
  synonymsJson     String?
  wordFamilyJson   String?
  tagsJson         String?
  sourceId         String
  sourceRef        String?
  license          String?
  externalRefsJson String?
  /**
   * ACTIVE | ARCHIVED
   */
  status           String    @default("ACTIVE")
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  source        VocabularySource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  memberships   VocabularyItemSource[]
  deckItems     VocabularyDeckItem[]
  mappings      ExternalWordMapping[]
  assignments   VocabularyAssignmentItem[] @relation("AssignmentItems")
  attempts      VocabularyAttempt[]
  knowledge     VocabularyKnowledgeState[]
  evidenceLinks VocabularyEvidenceLink[]

  @@unique([language, normalizedLemma, pos, senseKey])
  @@index([lemma])
  @@index([normalizedLemma])
  @@index([sourceId])
  @@index([status])
  @@index([archivedAt])
}

// ── V3 词条多来源归属（同一词条来自不同词书时保留全部来源） ──
model VocabularyItemSource {
  id        String   @id @default(cuid())
  itemId    String
  sourceId  String
  sourceRef String   @default("")
  note      String?
  createdAt DateTime @default(now())

  item   VocabularyItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source VocabularySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([itemId, sourceId, sourceRef])
  @@index([sourceId])
}

// ── V4 可分发 Deck ──
model VocabularyDeck {
  id             String    @id @default(cuid())
  title          String
  targetStage    String?
  language       String    @default("en")
  tagsJson       String?
  version        Int       @default(1)
  dailyNewTarget Int       @default(10)
  reviewCap      Int       @default(40)
  externalDeckId String?
  lastSyncedAt   DateTime?
  sourceId       String?
  /**
   * ACTIVE | ARCHIVED
   */
  status         String    @default("ACTIVE")
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  source      VocabularySource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items       VocabularyDeckItem[]
  assignments VocabularyAssignment[]
  mappings    ExternalWordMapping[]

  @@index([status])
  @@index([targetStage])
  @@index([archivedAt])
}

model VocabularyDeckItem {
  id        String   @id @default(cuid())
  deckId    String
  itemId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  deck VocabularyDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  item VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([deckId, itemId])
  @@index([deckId, sortOrder])
  @@index([itemId])
}

// ── V5 外部词条映射（映射不等于掌握；外部状态独立保存） ──
model ExternalWordMapping {
  id                 String    @id @default(cuid())
  provider           String    @default("TYPEWORDS")
  providerInstanceId String    @default("default")
  externalWordId     String
  itemId             String?
  deckId             String?
  /**
   * 外部应用状态快照（NEW/LEARNING/WRONG/FAVORITE/MASTERED/DUE 等，原样字符串）
   */
  externalState      String?
  externalStateJson  String?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  item VocabularyItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  deck VocabularyDeck? @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@unique([provider, providerInstanceId, externalWordId])
  @@index([itemId])
  @@index([deckId])
}

// ── V6 每日词汇任务（与 PlanTask 同事务关联；词汇时间与总预算共用） ──
model VocabularyAssignment {
  id                 String    @id @default(cuid())
  assignmentDate     String
  budgetMinutes      Int
  reviewTarget       Int       @default(0)
  newTarget          Int       @default(0)
  estimatedMinutes   Int       @default(0)
  /**
   * PLANNED | SENT | IN_PROGRESS | DONE | SKIPPED
   */
  status             String    @default("PLANNED")
  priorityPolicyJson String?
  rationale          String?
  deckId             String?
  planTaskId         String?
  externalDeckId     String?
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deck     VocabularyDeck?             @relation(fields: [deckId], references: [id], onDelete: SetNull)
  planTask PlanTask?                   @relation(fields: [planTaskId], references: [id], onDelete: SetNull)
  items    VocabularyAssignmentItem[]
  sessions VocabularyPracticeSession[]

  @@unique([assignmentDate])
  @@index([status])
  @@index([planTaskId])
}

model VocabularyAssignmentItem {
  id           String   @id @default(cuid())
  assignmentId String
  itemId       String
  /**
   * P0 | P1 | P2 | P3
   */
  priority     String   @default("P1")
  /**
   * REVIEW | NEW | WEAKNESS
   */
  kind         String   @default("NEW")
  /**
   * 建议模式（跟写/听写/自测/默写）
   */
  mode         String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  assignment VocabularyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  item       VocabularyItem       @relation("AssignmentItems", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, itemId])
  @@index([assignmentId, sortOrder])
  @@index([itemId])
}

// ── V7 外部练习会话（幂等键 provider + instance + externalSessionId） ──
model VocabularyPracticeSession {
  id                 String   @id @default(cuid())
  provider           String   @default("TYPEWORDS")
  providerInstanceId String   @default("default")
  externalSessionId  String
  deckExternalId     String?
  /**
   * 源码真实模式；不可用时为 UNAVAILABLE，不伪造 0
   */
  mode               String?
  startedAt          DateTime
  endedAt            DateTime
  durationSeconds    Int
  /**
   * 有效秒数（扣除与既有学习记录重叠的区间）
   */
  effectiveSeconds   Int?
  overlapAdjusted    Boolean  @default(false)
  summaryJson        String?
  correctCount       Int?
  incorrectCount     Int?
  /**
   * SUMMARY_ONLY | ATTEMPT
   */
  granularity        String   @default("SUMMARY_ONLY")
  sourceVersion      String?
  payloadHash        String
  importedAt         DateTime @default(now())
  jobId              String?
  assignmentId       String?
  planTaskId         String?
  studySessionId     String?
  createdAt          DateTime @default(now())

  job          IntegrationJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assignment   VocabularyAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  planTask     PlanTask?             @relation(fields: [planTaskId], references: [id], onDelete: SetNull)
  studySession StudySession?         @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  attempts     VocabularyAttempt[]

  @@unique([provider, providerInstanceId, externalSessionId])
  @@index([startedAt])
  @@index([assignmentId])
  @@index([planTaskId])
  @@index([jobId])
}

// ── V8 逐词尝试（仅当源文件真实提供时写入；summary-only 会话没有 attempt） ──
model VocabularyAttempt {
  id                String    @id @default(cuid())
  sessionId         String
  externalAttemptId String
  externalWordId    String?
  itemId            String?
  occurredAt        DateTime?
  mode              String?
  /**
   * CORRECT | INCORRECT | SKIPPED
   */
  result            String
  latencyMs         Int?
  errorType         String?
  typedInput        String?
  hintUsed          Boolean?
  createdAt         DateTime  @default(now())

  session VocabularyPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    VocabularyItem?           @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([sessionId, externalAttemptId])
  @@index([itemId])
  @@index([result])
}

// ── V9 多维知识状态（每词每维度一行，绝不压成单一分数） ──
model VocabularyKnowledgeState {
  id             String   @id @default(cuid())
  itemId         String
  /**
   * FORM_RECOGNITION | MEANING_RECOGNITION | MEANING_RECALL | SPELLING_RECALL | LISTENING_RECOGNITION | CONTEXT_UNDERSTANDING | PRODUCTIVE_USE
   */
  dimension      String
  /**
   * UNKNOWN | INTRODUCED | RECOGNIZED | RECALLED | CONTEXT_UNDERSTOOD | PRODUCTIVE_USE_VERIFIED
   */
  status         String   @default("UNKNOWN")
  confidence     String   @default("LOW")
  evidenceCount  Int      @default(0)
  lastVerifiedAt String?
  lastEvidenceId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  item VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, dimension])
  @@index([status])
  @@index([lastVerifiedAt])
}

// ── V10 复用 EvidenceRecord 的词汇证据链接（不另建证据表） ──
model VocabularyEvidenceLink {
  id         String   @id @default(cuid())
  evidenceId String   @unique
  itemId     String
  dimension  String
  createdAt  DateTime @default(now())

  evidence EvidenceRecord @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  item     VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, dimension])
  @@index([evidenceId])
}

// ── V11 外部引擎连接（不保存第三方账号密码） ──
model IntegrationConnection {
  id               String    @id @default(cuid())
  provider         String    @default("TYPEWORDS")
  name             String
  /**
   * FILE | BRIDGE
   */
  mode             String    @default("FILE")
  endpoint         String?
  pinnedVersion    String?
  capabilitiesJson String?
  licenseNote      String?
  enabled          Boolean   @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  jobs IntegrationJob[]

  @@unique([provider, name])
  @@index([enabled])
}

// ── V12 同步任务与审计（原始 payload + hash + 错误报告；可重试） ──
model IntegrationJob {
  id           String    @id @default(cuid())
  connectionId String?
  provider     String    @default("TYPEWORDS")
  /**
   * EXPORT_DECK | IMPORT_BACKUP | IMPORT_SESSION
   */
  direction    String
  /**
   * queued | running | succeeded | partial | failed | retrying
   */
  status       String    @default("queued")
  fileName     String?
  payloadHash  String?
  payloadText  String?
  countsJson   String?
  errorReport  String?
  retryCount   Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  connection IntegrationConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  sessions   VocabularyPracticeSession[]

  @@index([direction, status])
  @@index([payloadHash])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.4 AI Learning Engine（全部为加法；不修改既有学习数据）
// ══════════════════════════════════════════════════════════════════════════════

// ── AI1 模型配置（价格与启用状态；密钥等凭据见 AIProviderCredential） ──
model AIModelConfig {
  id                 String   @id @default(cuid())
  provider           String
  model              String
  label              String
  capabilitiesJson   String?
  active             Boolean  @default(true)
  isDefault          Boolean  @default(false)
  contextWindow      Int?
  inputPricePerMtok  Float    @default(0)
  outputPricePerMtok Float    @default(0)
  parametersJson     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions AILearningSession[]

  @@unique([provider, model])
  @@index([isDefault])
}

// ── AI2 提示词模板与版本（已使用版本不可覆盖，只能追加） ──
model PromptTemplate {
  id        String   @id @default(cuid())
  promptKey String   @unique
  purpose   String
  mode      String
  createdAt DateTime @default(now())

  versions PromptVersion[]
}

model PromptVersion {
  id               String    @id @default(cuid())
  templateId       String
  version          Int
  systemTemplate   String
  userTemplate     String
  inputSchemaJson  String?
  outputSchemaJson String?
  status           String    @default("DRAFT") // DRAFT|PUBLISHED|RETIRED
  testSamplesJson  String?
  checksum         String
  createdBy        String    @default("system")
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  template PromptTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sessions AILearningSession[]
  turns    AILearningTurn[]
  callLogs AICallLog[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

// ── AI3 教学会话（状态机主表） ──
model AILearningSession {
  id                String    @id @default(cuid())
  mode              String
  skill             String
  objective         String
  targetLevel       String?
  status            String    @default("CREATED")
  promptTemplateKey String
  promptVersionId   String?
  modelConfigId     String?
  provider          String
  model             String
  baselineText      String?
  contextJson       String?
  taskSpecJson      String?
  rubricJson        String?
  allowedAidsJson   String?
  directTeaching    Boolean   @default(false)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  pausedAt          DateTime?
  failureReason     String?
  estimatedCostUsd  Float     @default(0)
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  totalLatencyMs    Int       @default(0)
  parentSessionId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  promptVersion PromptVersion?         @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  modelConfig   AIModelConfig?         @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)
  turns         AILearningTurn[]
  tasks         LearningTaskInstance[]
  callLogs      AICallLog[]
  feedback      AISessionFeedback[]
  evidence      EvidenceRecord[]
  parent        AILearningSession?     @relation("AISessionChain", fields: [parentSessionId], references: [id], onDelete: SetNull)
  children      AILearningSession[]    @relation("AISessionChain")

  @@index([status, createdAt])
  @@index([mode])
  @@index([skill])
}

// ── AI4 会话轮次（用户原始答案与 AI 输出按 role/kind 分离） ──
model AILearningTurn {
  id              String   @id @default(cuid())
  sessionId       String
  sequence        Int
  role            String // USER|AI|SYSTEM
  kind            String
  contentText     String
  structuredJson  String?
  aidLevel        String?
  promptVersionId String?
  requestId       String?
  clientRequestId String?
  latencyMs       Int?
  inputTokens     Int?
  outputTokens    Int?
  createdAt       DateTime @default(now())

  session       AILearningSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion?      @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  feedback      AISessionFeedback[]

  @@unique([sessionId, sequence])
  @@unique([sessionId, clientRequestId])
  @@index([sessionId, createdAt])
}

// ── AI5 任务实例（AI 生成的 TaskSpec 落库；建议进入正式计划需用户确认） ──
model LearningTaskInstance {
  id               String   @id @default(cuid())
  sessionId        String?
  linkedPlanTaskId String?
  taskSpecJson     String
  source           String   @default("AI")
  estimatedMinutes Int      @default(10)
  difficulty       String?
  allowedAidsJson  String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session AILearningSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([linkedPlanTaskId])
}

// ── AI6 调用日志（Token/成本/时延/错误；不存密钥与完整提示词） ──
model AICallLog {
  id                   String   @id @default(cuid())
  sessionId            String?
  provider             String
  model                String
  promptVersionId      String?
  requestId            String
  latencyMs            Int
  inputTokens          Int      @default(0)
  outputTokens         Int      @default(0)
  estimatedCostUsd     Float    @default(0)
  status               String // OK|MOCK|ERROR|TIMEOUT|INVALID_OUTPUT|BLOCKED
  errorCode            String?
  redactedMetadataJson String?
  /// v2.6：材料域调用归属（教学回合调用为 null）；材料删除后置 null，账本保留
  materialId           String?
  materialJobId        String?
  createdAt            DateTime @default(now())

  session       AILearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  promptVersion PromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([sessionId])
  @@index([materialId])
}

// ── AI7 用户反馈（有帮助/无帮助/不准确） ──
model AISessionFeedback {
  id          String   @id @default(cuid())
  sessionId   String
  turnId      String?
  helpfulness String // HELPFUL|UNHELPFUL|INACCURATE
  note        String?
  createdAt   DateTime @default(now())

  session AILearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn    AILearningTurn?   @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

// ── AI8 引擎设置（单行；外部 AI 默认关闭） ──
model AIEngineSetting {
  id                    String   @id @default("default")
  externalAiEnabled     Boolean  @default(false)
  dailyBudgetUsd        Float    @default(1)
  monthlyBudgetUsd      Float    @default(20)
  warnPercent           Int      @default(80)
  directTeachingDefault Boolean  @default(false)
  explainLanguage       String   @default("ZH_MIXED")
  updatedAt             DateTime @updatedAt
}

// ── AI9 Provider 凭据（单行；前端页面配置，API Key 加密入库、不回显明文） ──
model AIProviderCredential {
  id           String    @id @default("default")
  baseUrl      String    @default("https://api.openai.com/v1")
  modelName    String    @default("gpt-4o-mini")
  apiKeyCipher String?
  apiKeyLast4  String?
  keyUpdatedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.4.1 AI Diagnostic & Intelligent Placement
// ══════════════════════════════════════════════════════════════════════════════

// ── D1 学习者背景（单行；只用于目标与排期，不参与能力定级） ──
model LearnerProfile {
  id                       String   @id @default("default")
  goalsJson                String?
  backgroundJson           String?
  recordingConsent         Boolean  @default(false)
  externalAiConsent        Boolean  @default(false)
  selfReportedWeaknessJson String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ── D2 诊断蓝图（版本化） ──
model DiagnosticBlueprint {
  id          String   @id @default(cuid())
  code        String   @unique
  version     String
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  items    DiagnosticItem[]
  sessions DiagnosticSession[]
}

// ── D3 诊断题目 / 任务 ──
model DiagnosticItem {
  id                String   @id @default(cuid())
  blueprintId       String
  itemCode          String   @unique
  /**
   * LISTENING | READING | SPEAKING_PRODUCTION | SPEAKING_INTERACTION | WRITING | GRAMMAR | VOCABULARY_RECEPTIVE | VOCABULARY_PRODUCTIVE | SENTENCE_STRUCTURE | EMLR
   */
  skill             String
  subskill          String
  targetLevelMin    String
  targetLevelMax    String
  difficulty        Int      @default(2)
  /**
   * MCQ | MULTI | SHORT_ANSWER | OPEN_WRITING | OPEN_SPEAKING
   */
  taskType          String
  /**
   * VERIFIED | RUBRIC | AI_PRACTICE
   */
  sourceType        String
  prompt            String
  passage           String?
  transcript        String?
  optionsJson       String?
  correctAnswer     String?
  answerExplanation String?
  rubricJson        String?
  rubricVersion     String   @default("v1")
  validationStatus  String   @default("VERIFIED")
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  exposureCount     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  blueprint DiagnosticBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  attempts  DiagnosticAttempt[]

  @@index([skill, difficulty])
  @@index([sourceType])
}

// ── D4 诊断会话 ──
model DiagnosticSession {
  id               String    @id @default(cuid())
  blueprintId      String?
  /**
   * CREATED | IN_PROGRESS | PAUSED | FINALIZING | COMPLETED | FAILED
   */
  status           String    @default("CREATED")
  goalSnapshotJson String?
  planJson         String?
  currentItemId    String?
  startedAt        DateTime?
  lastActivityAt   DateTime?
  completedAt      DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  blueprint DiagnosticBlueprint?   @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  attempts  DiagnosticAttempt[]
  snapshots SkillProfileSnapshot[]
  report    PlacementReport?

  @@index([status])
  @@index([createdAt])
}

// ── D5 单次尝试（原始作答只写一次） ──
model DiagnosticAttempt {
  id                  String   @id @default(cuid())
  sessionId           String
  itemId              String
  sequence            Int
  /**
   * SUBMITTED | PENDING_EVAL | SCORED | INVALID | NEEDS_REVIEW
   */
  status              String   @default("SUBMITTED")
  responseText        String?
  responseJson        String?
  timeSpentSec        Int?
  technicalStatusJson String?
  score               Int?
  maxScore            Int?
  /**
   * DETERMINISTIC | AI | INVALID
   */
  evaluatorType       String   @default("DETERMINISTIC")
  confidence          String   @default("LOW")
  rubricVersion       String?
  evidenceId          String?  @unique
  submittedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session    DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item       DiagnosticItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  evidence   EvidenceRecord?   @relation("DiagnosticEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  assessment AssessmentResult?
  assets     DiagnosticAsset[]

  @@unique([sessionId, itemId, sequence])
  @@index([sessionId, status])
}

// ── D6 诊断资产（录音等原始材料） ──
model DiagnosticAsset {
  id          String   @id @default(cuid())
  attemptId   String
  /**
   * AUDIO | WRITING_SNAPSHOT | MATERIAL
   */
  kind        String
  /**
   * 本机 data URL 或相对路径；不写入外部服务
   */
  storagePath String?
  mimeType    String?
  sizeBytes   Int?
  sha256      String?
  durationSec Int?
  createdAt   DateTime @default(now())

  attempt DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// ── D7 评分结果（与原始作答分离） ──
model AssessmentResult {
  id               String   @id @default(cuid())
  attemptId        String   @unique
  skill            String
  subskill         String
  dimensionJson    String?
  estimatedLevel   String?
  levelRangeJson   String?
  confidence       String   @default("LOW")
  rubricVersion    String?
  evidenceRefsJson String?
  limitationsJson  String?
  needsFollowUp    Boolean  @default(false)
  /**
   * AI | DETERMINISTIC | HUMAN
   */
  assessorType     String   @default("AI")
  createdAt        DateTime @default(now())

  attempt DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

// ── D8 能力画像快照（每会话每技能一行） ──
model SkillProfileSnapshot {
  id              String   @id @default(cuid())
  sessionId       String
  skill           String
  estimatedLevel  String?
  levelRangeJson  String?
  confidence      String   @default("LOW")
  coverageJson    String?
  evidenceCount   Int      @default(0)
  limitationsJson String?
  needsFollowUp   Boolean  @default(false)
  createdAt       DateTime @default(now())

  session DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, skill])
}

// ── D9 诊断报告（追加式） ──
model PlacementReport {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  version         Int      @default(1)
  /**
   * FINAL | PROVISIONAL | SUPERSEDED
   */
  status          String   @default("FINAL")
  summary         String
  strengthsJson   String?
  gapsJson        String?
  coverageJson    String?
  suggestionsJson String?
  confidence      String   @default("LOW")
  limitationsJson String?
  supersededById  String?
  createdAt       DateTime @default(now())

  session        DiagnosticSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proposals      PlanProposal[]
  reviewRequests DiagnosticReviewRequest[]
}

// ── D10 学习计划草案（用户确认后才 ACTIVE） ──
model PlanProposal {
  id            String    @id @default(cuid())
  reportId      String
  /**
   * DRAFT | ACTIVE | ARCHIVED
   */
  status        String    @default("DRAFT")
  horizonDays   Int
  tasksJson     String
  rationaleJson String?
  budgetJson    String?
  createdAt     DateTime  @default(now())
  activatedAt   DateTime?

  report PlacementReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ── D11 复核 / 异议请求 ──
model DiagnosticReviewRequest {
  id             String   @id @default(cuid())
  reportId       String
  reason         String
  /**
   * OPEN | IN_REVIEW | RESOLVED
   */
  status         String   @default("OPEN")
  resolutionNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  report PlacementReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// v2.5 Listening & Speaking Lab（纯加法；音频落盘 storage/uploads，DB 只存相对路径 + sha256）
// ─────────────────────────────────────────────────────────────────────────

// ── v2.5-A 音源（上传音频 / 材料音频 / 题库内部音频 / 外部链接） ──
model AudioAsset {
  id             String   @id @default(cuid())
  title          String
  /**
   * UPLOAD | MATERIAL | INTERNAL | EXTERNAL_URL
   */
  source         String   @default("UPLOAD")
  sourceUrl      String?
  /**
   * 相对路径（storage/uploads 下）或外部 URL；audio 二进制不写 DB。
   */
  filePath       String
  fileName       String?
  mimeType       String?
  sizeBytes      Int?
  sha256         String?
  durationSec    Int?
  language       String?
  /**
   * 方言/口音标签（仅素材描述，不作为能力推断依据）。
   */
  dialectTag     String?
  /**
   * 作者/权利信息（已知时填写）。
   */
  rightsInfo     String?
  /**
   * ACTIVE | ARCHIVED
   */
  permissionState String  @default("ACTIVE")
  createdAt      DateTime @default(now())

  transcripts        Transcript[]
  listeningExercises ListeningExercise[]

  @@index([source])
  @@index([sha256])
}

// ── v2.5-C 转写（机器原始 / 手动 / 用户修订，版本链分离） ──
model Transcript {
  id                String   @id @default(cuid())
  audioAssetId      String?
  recordingAssetId  String?
  /**
   * MACHINE | MANUAL | REVISED
   */
  kind              String   @default("MACHINE")
  parentTranscriptId String?
  provider          String?
  model             String?
  language          String?
  /**
   * LOW | MEDIUM | HIGH
   */
  confidence        String?
  /**
   * DRAFT | CONFIRMED
   */
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  segments TranscriptSegment[]

  audioAsset     AudioAsset?     @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)
  recordingAsset RecordingAsset? @relation(fields: [recordingAssetId], references: [id], onDelete: Cascade)

  @@index([audioAssetId])
  @@index([recordingAssetId])
}

model TranscriptSegment {
  id           String   @id @default(cuid())
  transcriptId String
  seq          Int
  startMs      Int?
  endMs        Int?
  text         String
  speaker      String?
  confidence   String?

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, seq])
}

// ── v2.5-B 听力练习与作答（首听 / 辅助后结果分离） ──
model ListeningExercise {
  id           String   @id @default(cuid())
  audioAssetId String
  /**
   * BLIND | GIST | DETAIL | DICTATION | TRANSCRIPT_COMPARISON |
   * CHUNKING | SHADOWING | RETELLING | TRANSFER
   */
  mode         String
  title        String
  promptJson   String?
  createdAt    DateTime @default(now())

  audioAsset AudioAsset         @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)
  attempts   ListeningAttempt[]

  @@index([audioAssetId])
}

model ListeningAttempt {
  id           String   @id @default(cuid())
  exerciseId   String
  evidenceId   String?
  /**
   * 首听结果 JSON（辅助前，不可被覆盖）。
   */
  firstListenResultJson String?
  /**
   * 辅助后结果 JSON（与首听分离保存）。
   */
  assistedResultJson    String?
  replayCount  Int      @default(0)
  /**
   * DRAFT | SUBMITTED
   */
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())

  exercise ListeningExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  errors   ListeningError[]

  @@index([exerciseId])
}

model ListeningError {
  id           String   @id @default(cuid())
  attemptId    String
  /**
   * UNKNOWN_VOCABULARY | KNOWN_WORD_NOT_RECOGNIZED | SEGMENTATION |
   * REDUCED_FORMS | SENTENCE_STRUCTURE | DISCOURSE_MARKER | MISSED_DETAIL |
   * ATTENTION_LOAD | BACKGROUND_KNOWLEDGE | AUDIO_QUALITY | UNKNOWN
   */
  errorType    String
  /**
   * RULE | AI | USER
   */
  source       String   @default("USER")
  note         String?
  /**
   * 技术质量/音频问题不计为英语能力错误。
   */
  isTechnical  Boolean  @default(false)
  userCorrected Boolean @default(false)
  createdAt    DateTime @default(now())

  attempt ListeningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// ── v2.5-D/E 口语题目、会话、录音、转写、评估 ──
model SpeakingPrompt {
  id           String   @id @default(cuid())
  /**
   * READ_ALOUD | SHORT_ANSWER | TOPIC_MONOLOGUE | PICTURE_DESCRIPTION |
   * RETELLING | ROLE_PLAY | FOLLOW_UP | CLARIFICATION | IELTS_PART
   */
  taskType     String
  title        String
  prompt       String
  rubricVersion String?
  createdAt    DateTime @default(now())

  sessions SpeakingSession[]

  @@index([taskType])
}

model SpeakingSession {
  id         String   @id @default(cuid())
  promptId   String?
  /**
   * PRACTICE | INTERACTION | RETEST
   */
  mode       String   @default("PRACTICE")
  /**
   * ACTIVE | COMPLETED | CANCELLED
   */
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  prompt    SpeakingPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  turns     SpeakingTurn[]
  recordings RecordingAsset[]

  @@index([promptId])
}

model SpeakingTurn {
  id               String   @id @default(cuid())
  sessionId        String
  /**
   * USER | AI
   */
  role             String
  seq              Int
  text             String?
  recordingAssetId String?
  transcriptId     String?
  createdAt        DateTime @default(now())

  session SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model RecordingAsset {
  id          String   @id @default(cuid())
  sessionId   String?
  /**
   * 相对路径（storage/uploads 下）；录音二进制不写 DB。
   */
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  sha256      String?
  durationSec Int?
  /**
   * 重录版本号（保留历史 take，从 1 递增）。
   */
  takeNumber  Int      @default(1)
  createdAt   DateTime @default(now())

  session     SpeakingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  transcripts Transcript[]
  asrResults  ASRResult[]

  @@index([sessionId])
}

model ASRResult {
  id               String   @id @default(cuid())
  recordingAssetId String
  transcriptId     String?
  provider         String
  model            String
  language         String?
  /**
   * PENDING | SUCCEEDED | FAILED
   */
  status           String   @default("PENDING")
  confidence       String?
  errorCode        String?
  latencyMs        Int?
  costUsd          Float?
  createdAt        DateTime @default(now())

  recordingAsset RecordingAsset @relation(fields: [recordingAssetId], references: [id], onDelete: Cascade)

  @@index([recordingAssetId])
}

// ── v2.5-E 口语评分（版本化 rubric；证据引用 + 置信度 + 局限） ──
model SpeechEvaluation {
  id               String   @id @default(cuid())
  sessionId        String?
  recordingAssetId String?
  rubricVersion    String
  /**
   * 分析维度 JSON；可见证据 JSON；局限 JSON（与评分理由分离）。
   */
  dimensionsJson   String
  evidenceJson     String?
  limitationsJson  String?
  confidence       String   @default("MEDIUM")
  needsFollowUp    Boolean  @default(false)
  /**
   * SELF | AI | HUMAN
   */
  assessorType     String   @default("AI")
  isOfficialScore  Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([sessionId])
  @@index([recordingAssetId])
}

// ── v2.5-E 音频技术检查（与英语能力分离） ──
model AudioTechnicalCheck {
  id               String   @id @default(cuid())
  recordingAssetId String
  /**
   * OK | SILENT | NOISE | CORRUPT | TOO_SHORT | UNKNOWN
   */
  status           String
  note             String?
  createdAt        DateTime @default(now())

  @@index([recordingAssetId])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.6 Smart Learning Materials（17 张新表；既有表仅 AICallLog +2 可空列）
//
// 设计要点（docs/32-v2.6-architecture.md §2）：
//   · 原文与 AI 衍生严格分表：ContentChunk 存原文且不可 update；AI 结果一律带
//     isDerived=true 且有 sourceQuote / evidenceQuote 供回验。
//   · 跨入既有表（PlanTask / EvidenceRecord / VocabularyItem）的引用一律用普通
//     String? + index，**不建 Prisma 关系**，避免触碰既有表结构。
//   · GeneratedExercise 与 Diagnostic* / AssessmentResult 零外键：未审核的 AI 题
//     在物理上无法进入 placement 链路（ADR-08）。
// ══════════════════════════════════════════════════════════════════════════════

// ── M1 材料主表（原文实体；不含任何 AI 文本） ──
model LearningMaterial {
  id                 String   @id @default(cuid())
  /// 用户可见标题（默认取文件名去扩展名，可编辑）
  title              String
  /// TXT|MARKDOWN|HTML|PDF|DOCX|PASTED_TEXT|AUDIO|VIDEO
  format             String
  /// created|validating|extracting|normalizing|analyzing|generating|review_required|ready|partial|failed|cancelled
  status             String   @default("created")
  /// 面向用户的降级/失败原因（人话，不含绝对路径）
  statusReason       String?
  /// user_upload|user_provided_url|public_domain|open_license|licensed_subscription|internal_library|unknown
  sourceType         String
  language           String   @default("en")

  /// 原始文件名（仅展示；落盘文件名已重命名）
  originFileName     String?
  /// 原始文件字节 sha256（PASTED_TEXT 为 null）
  fileHash           String?
  /// 去重键：文件=字节 sha256；粘贴=清洗后文本 sha256
  contentHash        String

  charCount          Int      @default(0)
  wordCount          Int      @default(0)
  pageCount          Int?
  chunkCount         Int      @default(0)
  /// 预计学习时长（按 wordCount/180wpm + 练习时长估算，四舍五入到 5 分钟）
  estimatedMinutes   Int?
  /// JSON string[]，官方四项技能子集：READING|WRITING|LISTENING|SPEAKING
  targetSkillsJson   String?
  /// AI 辅助估计，界面必须标注「AI 辅助估计，非官方认证」
  difficultyEstimate String?
  /// 生成时学习者等级快照（来自 SkillProfile.direction 或 A0 兜底）
  learnerLevelAtGen  String?

  /// 命中同 hash 且用户选「另存副本」时指向原材料
  duplicateOfId      String?
  /// 可选关联现有 SOP 资源（不污染 Resource 语义）
  resourceId         String?

  /// 单材料 AI 用量（防费用爆炸，Q5）
  aiCallCount        Int      @default(0)
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  estimatedCostUsd   Float    @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resource           Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  source             MaterialSource?
  permissionRecords  MaterialPermissionRecord[]
  assets             MaterialAsset[]
  jobs               ProcessingJob[]
  parsedDocuments    ParsedDocument[]
  chunks             ContentChunk[]
  extractions        ExtractionResult[]
  vocabCandidates    VocabularyCandidate[]
  sentenceCandidates SentenceCandidate[]
  exerciseSets       MaterialExerciseSet[]
  exercises          GeneratedExercise[]
  attempts           ExerciseAttempt[]
  pack               MaterialPack?
  taskProposals      TaskProposal[]

  @@index([contentHash])
  @@index([status])
  @@index([format])
  @@index([sourceType])
  @@index([createdAt])
  @@index([resourceId])
  @@index([duplicateOfId])
}

// ── M2 来源与权限登记（1:1 材料；PRD §3.1 七类来源） ──
model MaterialSource {
  id              String   @id @default(cuid())
  materialId      String   @unique
  sourceType      String
  /// P1 网页导入时保存；P0 仅保存用户贴的链接
  url             String?
  author          String?
  publisher       String?
  publishedYear   Int?
  /// 许可名称（open_license 必填，见 zod 层）
  licenseName     String?
  licenseUrl      String?
  /// 用户备注
  userNote        String?
  /// 用户勾选「我确认有权使用」（禁止预设勾选，A-01）
  rightsConfirmed   Boolean  @default(false)
  rightsConfirmedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

// ── M3 权限行为留痕（append-only；用于断言 R1/R2 与审计） ──
model MaterialPermissionRecord {
  id         String   @id @default(cuid())
  materialId String
  /// EXPORT_BLOCKED|SHARE_BLOCKED|FETCH_BLOCKED|DELETE_WARNED|RIGHTS_CONFIRMED|LICENSE_REQUIRED
  action     String
  /// 触发规则，如 sourceType=unknown / http_403 / robots_disallow
  rule       String
  note       String?
  createdAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, action])
}

// ── M4 材料资产（原文文件 / 派生 JSON / 解析快照）──
model MaterialAsset {
  id           String   @id @default(cuid())
  materialId   String
  /// ORIGINAL_FILE|PARSED_JSON|PAGE_TEXT|AUDIO_REF
  kind         String
  /// 相对路径：materials/{materialId}/original.pdf（**绝不暴露给客户端**）
  relativePath String
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  sha256       String?
  /// 原文资产必须 true（应用层禁写 + 落盘 0444）
  isReadOnly   Boolean  @default(false)
  /// P1：音频资产指向 AudioAsset.id（不重复建表）
  audioAssetId String?
  createdAt    DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, kind])
  @@unique([materialId, relativePath])
}

// ── M5 处理任务（ADR-05：表 + 串行 tick，无队列中间件） ──
model ProcessingJob {
  id               String   @id @default(cuid())
  materialId       String
  /// validating|extracting|normalizing|analyzing|generating|cancelled|done
  stage            String   @default("validating")
  /// running|succeeded|failed|cancelled
  status           String   @default("running")
  /// 1 起；重试 +1（A-08）
  attempt          Int      @default(1)
  /// 机器码：INVALID_MAGIC|FILE_TOO_LARGE|PDF_TOO_MANY_PAGES|PARSE_TIMEOUT|NO_TEXT|SCHEMA_VALIDATION|BUDGET_EXCEEDED|AI_CALL_LIMIT|CANCELLED
  errorCode        String?
  /// 人话原因（不含绝对路径 / 不含全文）
  errorMessage     String?
  cancelRequested  Boolean  @default(false)
  /// 乐观锁版本（ADR-05 并发控制）
  lockVersion      Int      @default(0)
  /// { stage, done, total, unitLabel }
  progressJson     String?
  aiCallCount      Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  estimatedCostUsd Float    @default(0)
  startedAt        DateTime @default(now())
  lastTickAt       DateTime?
  finishedAt       DateTime?

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, startedAt])
  @@index([status])
}

// ── M6 解析版本（重跑产生新 version；旧版本保留可追溯） ──
model ParsedDocument {
  id             String   @id @default(cuid())
  materialId     String
  /// 1 起单调递增；同一材料只有一个 isCurrent=true
  version        Int
  /// TXT|MARKDOWN|HTML|DOCX|PDF|PASTED_TEXT
  parserName     String
  /// 解析器实现版本，如 "pdfjs-5.4" / "ooxml-1"；用于溯源与回归
  parserVersion  String
  /// OK|PARTIAL
  status         String   @default("OK")
  pageCount      Int?
  paragraphCount Int      @default(0)
  charCount      Int      @default(0)
  /// JSON: { noTextLayerPages: number[], droppedImages: n, droppedFootnotes: n, droppedComments: n, droppedTextboxes: n, removedHtmlNodes: n, markerCollisions: n, hardSplits: n }
  warningsJson   String?
  /// 与 ParsedDocument 一一对应的纯文本快照 sha256（用于校验未被覆写）
  textChecksum   String?
  isCurrent      Boolean  @default(true)
  createdAt      DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunks   ContentChunk[]

  @@unique([materialId, version])
  @@index([materialId, isCurrent])
}

// ── M7 内容分块（原文，**不可 update**；派生文本一律不写这里） ──
model ContentChunk {
  id               String   @id @default(cuid())
  materialId       String
  parsedDocumentId String
  /// 1 起单调；chunk 内 [prevChunkId, nextChunkId] 双向链
  seq              Int
  /// HEADING|PARAGRAPH|TABLE|LIST|MIXED
  kind             String   @default("MIXED")
  /// 标题路径，如 "Chapter 2 > 2.1 Vocabulary"（Reader 目录跳转用）
  headingPath      String?
  /// 1 起；PASTED_TEXT/非分页格式为 null
  page             Int?
  /// 文档级段落序号（ADR-03 的 paragraphIndex）
  paragraphIndex   Int?
  /// 文档级绝对字符偏移 [charStart, charEnd)（ADR-03）
  charStart        Int
  charEnd          Int
  text             String
  textHash         String
  charCount        Int
  estTokens        Int      @default(0)
  /// 注入疑似标记，逗号分隔：instruction_override|system_impersonation|shell_command|secret_probe
  suspicionFlags   String?
  prevChunkId      String?
  nextChunkId      String?
  createdAt        DateTime @default(now())

  material       LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  parsedDocument ParsedDocument   @relation(fields: [parsedDocumentId], references: [id], onDelete: Cascade)

  extractions        ExtractionResult[]
  vocabCandidates    VocabularyCandidate[]
  sentenceCandidates SentenceCandidate[]
  exercises          GeneratedExercise[]

  @@unique([parsedDocumentId, seq])
  @@index([materialId, seq])
  @@index([materialId, page])
}

// ── M8 AI 提取结果（材料级或 chunk 级；全部 isDerived=true 语义） ──
model ExtractionResult {
  id             String   @id @default(cuid())
  materialId     String
  /// chunk 级提取必填；SUMMARY/TOPIC 为 null（用 sourceChunkIdsJson）
  chunkId        String?
  /// SUMMARY|TOPIC|KEYWORD|COLLOCATION|KEY_SENTENCE|PARAGRAPH_GIST|GRAMMAR_POINT
  kind           String
  /// 结构化负载（snake_case，来自 zod 校验后的对象）
  payloadJson    String
  /// 原文引用片段（SourceVerifier 已回验通过；**为空的行不允许存在**）
  sourceQuote    String
  /// 多源结果（SUMMARY 依赖哪些 chunk）
  sourceChunkIdsJson String?
  page           Int?
  paragraphIndex Int?
  charStart      Int?
  charEnd        Int?
  /// SourceVerifier 通过=true；仅 true 可入库（G1）
  sourceVerified Boolean  @default(false)
  /// 恒 true（AI 衍生）
  isDerived      Boolean  @default(true)
  /// 生成该行的 AICallLog.id（溯源 + 费用归属）
  aiCallLogId    String?
  promptVersionId String?
  /// draft|accepted|edited|rejected
  reviewStatus   String   @default("draft")
  /// 用户编辑后的 payload（原 payloadJson 保留，不覆盖 AI 原始输出）
  editedPayloadJson String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunk    ContentChunk?    @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([materialId, kind, reviewStatus])
  @@index([materialId, page])
  @@index([chunkId])
}

// ── M9 词汇候选（与主库 VocabularyItem 物理分离，E-01） ──
model VocabularyCandidate {
  id               String   @id @default(cuid())
  materialId       String
  chunkId          String
  /// AI 给出的词形（保留原文大小写/连字符）
  surfaceForm      String
  /// AI 给出的 lemma
  lemma            String
  /// lemmaNormalize() 派生（ADR-07）
  normalizedLemma  String
  /// 空串 = 未知（沿用主库约定，不用 NULL 以保唯一约束生效）
  pos              String   @default("")
  senseKey         String   @default("default")
  /// 释义候选（AI，需用户确认；不是权威释义）
  definitionZh     String?
  definitionEn     String?
  collocationsJson String?
  /// 原文上下文句（含该词的那一句）
  contextSentence  String
  /// sha256(normalize(contextSentence)) 前 16 位（E-02 去重键）
  contextHash      String
  page             Int?
  paragraphIndex   Int?
  charStart        Int?
  charEnd          Int?
  occurrenceCount  Int      @default(1)
  /// 主库是否已存在同键词条（导入时快照，UI 显示「已在词库，将只加来源」）
  existsInLibrary  Boolean  @default(false)
  existingItemId   String?
  isDerived        Boolean  @default(true)
  aiCallLogId      String?
  /// draft|accepted|edited|rejected
  reviewStatus     String   @default("draft")
  /// pending|synced|skipped|failed
  syncStatus       String   @default("pending")
  syncError        String?
  syncedItemId     String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunk    ContentChunk     @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([materialId, normalizedLemma, pos, senseKey, contextHash])
  @@index([materialId, reviewStatus])
  @@index([materialId, syncStatus])
}

// ── M10 重点句 / 句法候选（C-04 句子主干标注为 AI 推断） ──
model SentenceCandidate {
  id                  String   @id @default(cuid())
  materialId          String
  chunkId             String
  /// 原文句子（逐字，SourceVerifier 回验）
  sentenceText        String
  /// AI 推断的主干（主谓宾骨架）
  skeletonText        String?
  /// 复杂度：SIMPLE|COMPOUND|COMPLEX|COMPOUND_COMPLEX
  complexity          String?
  /// JSON string[]：语法现象标签（辅助维度，不产生官方技能等级）
  grammarPointsJson   String?
  /// 为什么成为重点句（AI 理由，短）
  note                String?
  page                Int?
  paragraphIndex      Int?
  charStart           Int?
  charEnd             Int?
  isDerived           Boolean  @default(true)
  aiCallLogId         String?
  /// draft|accepted|edited|rejected
  reviewStatus        String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunk    ContentChunk     @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkId, sentenceText])
  @@index([materialId, reviewStatus])
}

// ── M11 练习集（材料内的一组题；Player 路由 /exercises/[setId]） ──
model MaterialExerciseSet {
  id               String   @id @default(cuid())
  materialId       String
  title            String
  /// READING|VOCABULARY|GRAMMAR（官方四项中与材料相关的子集；辅助维度另存）
  targetSkill      String
  /// A0|A1|A2|B1|B2|C1（AI 辅助估计）
  difficultyLevel  String?
  /// 建议做题顺序（exerciseId[]）
  orderingJson     String?
  estimatedMinutes Int      @default(10)
  /// 只含 approved 题时才 true（UI 用它区分「仅练习」/「可作正式练习」）
  hasApprovedOnly  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material  LearningMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  exercises GeneratedExercise[]
  attempts  ExerciseAttempt[]

  @@index([materialId, isActive])
}

// ── M12 生成题（D-04 必备字段全在此；与 Diagnostic*/AssessmentResult 零外键 → ADR-08） ──
model GeneratedExercise {
  id                 String   @id @default(cuid())
  materialId         String
  setId              String
  chunkId            String
  /// reading_gist|reading_detail|vocab_in_context|vocab_collocation|grammar_error
  type               String
  /// READING|VOCABULARY|GRAMMAR
  targetSkill        String
  /// 子技能，如 gist_understanding / detail_scanning / word_in_context
  subskill           String?
  /// JSON string[]：辅助维度（Grammar/Vocab/SentenceStructure），**不产生官方等级**
  auxiliaryDimensionsJson String?
  /// A0..C1（AI 辅助估计，UI 必须标注）
  difficultyEstimate String?
  /// 题干
  prompt             String
  /// JSON: { options: [{key,text}], correctKey, isSingleAnswer } —— 客观题唯一答案（D-01~D-03）
  answerJson         String
  /// 解析（为什么这是答案）
  explanation        String
  /// 答案依据片段（原文逐字，SourceVerifier 回验）
  evidenceQuote      String
  /// 来源定位快照（chunk 被删也能显示位置）
  page               Int?
  paragraphIndex     Int?
  charStart          Int?
  charEnd            Int?
  isAiGenerated      Boolean  @default(true)
  /// draft|needs_review|approved|rejected|retired
  reviewStatus       String   @default("draft")
  /// 「答案可由来源推出」一致性自检结果：pass|fail|unchecked
  consistencyCheck   String   @default("unchecked")
  consistencyNote    String?
  /// 去重键：sha256(type|prompt|answerJson|chunkId) 前 16 位（D-10）
  dedupeKey          String
  /// 生成来源（模型 + prompt 版本），满足 D-04 溯源
  model              String?
  promptVersionId    String?
  aiCallLogId        String?
  retiredAt          DateTime?
  retireReason       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  material LearningMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  set      MaterialExerciseSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  chunk    ContentChunk         @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  attempts ExerciseAttempt[]

  @@index([materialId, type, reviewStatus])
  @@index([setId])
  @@index([materialId, dedupeKey])
}

// ── M13 作答记录（用户资产：材料删除后是否保留？→ 随材料级联删，但 EvidenceRecord 独立保留） ──
model ExerciseAttempt {
  id             String   @id @default(cuid())
  materialId     String
  setId          String
  exerciseId     String
  /// JSON: { selectedKey, isCorrect, elapsedSec }
  responseJson   String
  isCorrect      Boolean?
  /// 作答时的审核状态快照（防止「事后改审核状态」篡改历史语义）
  reviewStatusAtAttempt String
  /// 关联证据（普通 String?，不建 Prisma 关系，避免触碰 v2.2 Evidence 表）
  evidenceId     String?
  /// ASSISTED|IMMEDIATE_RETEST|PRACTICE_ONLY（BASELINE 永不出现，ADR-08）
  evidenceType   String   @default("PRACTICE_ONLY")
  /// 材料被删后 attempt 随材料级联删除；EvidenceRecord 独立存在（G-01）
  createdAt      DateTime @default(now())

  material LearningMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  set      MaterialExerciseSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  exercise GeneratedExercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
  @@index([exerciseId])
  @@index([setId])
}

// ── M14 材料包（F-01：只聚合引用，不复制内容） ──
model MaterialPack {
  id               String   @id @default(cuid())
  materialId       String   @unique
  /// AI 生成的学习目标（isDerived；UI 标 AI 徽章）
  learningGoalsJson String?
  /// JSON string[]：官方四项技能子集
  targetSkillsJson String?
  /// A0..C1（AI 辅助估计）
  difficultyEstimate String?
  estimatedMinutes Int      @default(30)
  /// 建议训练顺序：MaterialPackItem.id[]
  orderingJson     String?
  /// 摘要引用（ExtractionResult.kind=SUMMARY 的 id；不复制正文）
  summaryId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material LearningMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  items    MaterialPackItem[]

  @@index([materialId])
}

// ── M15 材料包条目（引用式聚合：块 / 提取项 / 词汇候选 / 练习集） ──
model MaterialPackItem {
  id               String   @id @default(cuid())
  packId           String
  /// CHUNK|EXTRACTION|VOCAB_CANDIDATE|SENTENCE|EXERCISE_SET
  itemType         String
  /// 指向对应表的 id（**弱引用**：被引用对象删除时该条目不删，UI 显示「内容已移除」）
  refId            String
  sortOrder        Int      @default(0)
  /// 该条目在训练顺序中的建议分钟
  estimatedMinutes Int?
  note             String?
  createdAt        DateTime @default(now())

  pack MaterialPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
  @@index([itemType, refId])
}

// ── M16 任务草案（F-02：受 v2.1 时间预算约束） ──
model TaskProposal {
  id               String   @id @default(cuid())
  materialId       String
  packId           String?
  /// 草案基准日（业务日期）
  baseDate         String
  /// 当日可用预算快照（getEffectiveBudget 结果，便于事后解释为何这样拆）
  budgetMinutes    Int
  totalMinutes     Int
  overflowDays     Int      @default(0)
  /// draft|confirmed|discarded
  status           String   @default("draft")
  /// AI 或规则给出的拆分理由（人话）
  rationale        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material LearningMaterial   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  items    TaskProposalItem[]

  @@index([materialId, status])
  @@index([status, baseDate])
}

// ── M17 任务草案条目（F-03：逐条勾选 / 改分钟 / 改日期，确认后才写 PlanTask） ──
model TaskProposalItem {
  id               String   @id @default(cuid())
  proposalId       String
  /// 复用 PlanTask.module 取值：VOCAB_REVIEW|GRAMMAR|LISTENING|READING|SPEAKING|WRITING|SENTENCE|EXTENSIVE|MEDIATED
  module           String
  /// 官方四项技能子集
  targetSkill      String
  title            String
  suggestedMinutes Int
  finalMinutes     Int?
  /// YYYY-MM-DD
  suggestedDate    String
  finalDate        String?
  /// 15|30|60 粒度
  granularity      Int      @default(30)
  reason           String?
  /// JSON string[]：完成该条目需要的练习集/exerciseId
  exerciseIdsJson  String?
  /// 用户是否勾选（F-03 只在 selected=true 时入库）
  selected         Boolean  @default(true)
  /// 确认后落地的 PlanTask.id（普通 String?，不建关系，避免触碰 v2.1 计划表）
  planTaskId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proposal TaskProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, suggestedDate])
  @@index([planTaskId])
}

// ══════════════════════════════════════════════════════════════════════════
// v2.7 规划内核（ADR-09）：输入快照 → 缺口 → 候选 → 优先级决策 → readiness
//
// 五张表共同要保证的一件事：**"为什么今天排了这些"可复现、可解释、可审计**。
// 因此每个环节都留一个可回读的快照/决策行，而不是把结论直接写进 PlanTask。
//
// 跨域引用（`sourceRef` / `aiCallLogId` / `PlanTask.candidateId` /
// `PlanVersion.snapshotId` / `SkillGap.evidenceIdsJson`）**一律是普通 String?**，
// 不建外键：v2.7 不触碰既有 110 张表的约束关系，删候选/删快照也不会级联
// 影响计划与账本（宁可留一个查不到的 id，也不要一次误删带走历史）。
// ══════════════════════════════════════════════════════════════════════════

// ── V27-1 计划输入快照（每次生成/重排各一行；保证可复现"为什么这样排"）──
model PlanningSnapshot {
  id                   String   @id @default(cuid())
  /// GENERATE | REPLAN | WEEKLY | CYCLE_CALIBRATION
  purpose              String
  /// 业务日期（快照针对哪一天/哪一周）
  asOfDate             String
  /// 幂等/缓存键：同输入同规则 → 同 hash，可用于断言确定性
  inputHash            String
  /// 规则版本（scheduler 语义版本，规则改动必须递增，否则历史不可复算）
  ruleVersion          String   @default("v2.7.0")
  /// JSON：预算快照 { budgetMinutes, tierCode, isRestDay, source, isInitialSuggestion }
  budgetJson           String
  /// JSON：画像/证据摘要 { skills:[{skill,direction,confidence,evidenceCount,independentCount,lastAssessedAt,freshDays}], gaps:[...] }
  profileJson          String?
  /// JSON：到期负荷 { dueReviewMinutes, dueReviewCount, maxOverdueDays, dueRetestItems:[...] }
  workloadJson         String?
  /// JSON：候选池摘要 [{candidateId, module, skill, estMinutes, minMinutes, priorityHint}]
  candidatesJson       String?
  /// JSON：配置快照 { minTaskMinutes, p0CapRatio, coreMinRatio, bufferRatio, allocation, weights }
  configJson           String
  /// JSON：输入校验结果 { ok, stale:[], missingBaseline:[], lowConfidence:[] }
  validationJson       String?
  createdAt            DateTime @default(now())

  gaps        SkillGap[]
  candidates  TaskCandidate[]
  reviews     StageReadinessReview[]

  @@unique([purpose, asOfDate, inputHash])
  @@index([asOfDate])
}

// ── V27-2 技能缺口（子维度粒度；官方四项与辅助维度共用一张表，靠 dimensionKind 分层）──
model SkillGap {
  id                String   @id @default(cuid())
  snapshotId        String
  /**
   * 语义分层：OFFICIAL = 四项官方能力；AUXILIARY = 语法/词汇/句子结构。
   *
   * **所有「四技能占比 / 配比分母 / 弱项排序」查询必须显式带 `dimensionKind: 'OFFICIAL'`。**
   * 辅助维度只允许出现在：候选任务、缺口清单、补测建议；**绝不**进入任何
   * `allocatedMinutes` 类字段的分母（否则 Grammar 缺口会让四项占比合计 ≠ 100%）。
   */
  dimensionKind     String   @default("OFFICIAL")
  /**
   * dimensionKind=OFFICIAL 时取 LISTENING|READING|SPEAKING|WRITING；
   * =AUXILIARY 时取 GRAMMAR|VOCABULARY|SENTENCE_STRUCTURE。
   */
  skill             String
  /// 子维度，如 gist_understanding / detail_scanning / coherence；空串 = 技能级缺口
  subskill          String   @default("")
  /// GAP（已证实）| UNCERTAINTY（证据不足，需补测）| UNKNOWN（无基线）
  kind              String
  /// LOW | MEDIUM | HIGH —— 与 SkillProfile.confidence 同源
  confidence        String   @default("LOW")
  /// 证据样本数（实时聚合，非快照冗余）
  evidenceCount     Int      @default(0)
  /// A0 无辅助样本数 —— 独立性门槛
  independentCount  Int      @default(0)
  /// 证据新鲜度（最近证据距 asOfDate 的天数；null = 无证据）
  freshnessDays     Int?
  /// 覆盖比例 0..1（coverage 分母由 blueprint 决定；null = 未知）
  coverageRatio     Float?
  /// 0..1，缺口严重度（证据支持下的偏离幅度；UNCERTAINTY 恒 0）
  severity          Float    @default(0)
  /// 一句话依据（人话，直接进解释面板）
  reason            String
  /// JSON string[]：支撑本缺口的 EvidenceRecord.id（可追溯，AC-8）
  evidenceIdsJson   String?
  /// JSON string[]：suggestProfileConfidence().gaps 原文
  missingEvidenceJson String?
  /// PENDING | ADDRESSED | SUPERSEDED
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())

  snapshot    PlanningSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  candidates  TaskCandidate[]
  decisions   TaskPriorityDecision[]

  /**
   * 一个维度在一次快照里**只有一个裁决**。
   *
   * 唯一键刻意**不含** `kind`：把 kind 放进来意味着同一维度可以同时是 GAP 与
   * UNCERTAINTY，双池立刻变成双份计数，"低置信度必须进 Uncertainty 且不进 ranked"
   * 就形同虚设。裁决互斥由 DB 保证，不靠应用层自觉。
   */
  @@unique([snapshotId, skill, subskill])
  @@index([skill, kind, status])
  @@index([dimensionKind])
}

// ── V27-3 候选任务（跨来源的统一视图；**不参与任何时长统计**）──
model TaskCandidate {
  id                 String   @id @default(cuid())
  snapshotId         String
  /// 候选来源（8 值）：REVIEW | RETEST | PROBE | VOCAB | MATERIAL | QUESTION | LAB | EGIU
  ///
  /// - `LAB` 合并了听力与口语两类实验性任务，用 `sourceRef = 'listening:<id>' | 'speaking:<id>'`
  ///   区分：两者的前置条件不同，但"能不能排"的归一是同一套规则，拆成两个枚举值只会让
  ///   调度器多两个必须同步维护的分支。
  /// - `EGIU` 拼写与源表 `EgiuLesson` 一致（旧设计写成 EGUI 是错的，且它有唯一约束意义）。
  /// - **`EXTENSIVE` 不是候选来源**：泛听泛读由 `generateAdaptivePlan` 第 ⑧ 步直接产出
  ///   （预算 ≥120 且剩余 ≥2 个粒度时给 P3）。若它同时是一个候选来源，同一块时间会被
  ///   生成两次 —— 这是本表最容易误加的一个值。
  sourceKind         String
  /// 源表弱引用（普通 String?，不建跨域外键，避免触碰既有 110 表）
  sourceRef          String?
  /// 稳定去重键：sourceKind:sourceRef:module:dateKey（幂等复用同一候选）
  candidateKey       String
  /// PlanTask.module 取值（14 值）
  module             String
  /// 四技能子集 + FOUNDATION
  targetSkill        String
  skillGapId         String?
  title              String
  /// 预计分钟
  estMinutes         Int
  /// 最小可执行单元（不生成低于它的碎片）
  minMinutes         Int      @default(5)
  /// 建议粒度上限（材料包用 15/30/60）
  maxBlockMinutes    Int?
  /// JSON string[]：前置条件（如 ['stage:S2_A2_B1','retest:D7_done']）
  prerequisitesJson  String?
  /// VERIFIED | RUBRIC | AI_PRACTICE | UNVERIFIED —— 未验证不得进正式估分
  validationStatus   String   @default("UNVERIFIED")
  /// 0..1 难度归一（A0..C1 → 0..1），用于难度匹配
  difficultyScore    Float?
  /// true = AI 建议生成（必须在 UI 标注）
  isAiSuggested      Boolean  @default(false)
  /// 关联 AI 调用日志（复用 v2.4 账本；普通 String?）
  aiCallLogId        String?
  /// PROPOSED | SELECTED | REJECTED | EXPIRED
  status             String   @default("PROPOSED")
  createdAt          DateTime @default(now())

  snapshot PlanningSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  gap      SkillGap?        @relation(fields: [skillGapId], references: [id], onDelete: SetNull)
  decision TaskPriorityDecision?

  @@unique([snapshotId, candidateKey])
  @@index([snapshotId, sourceKind])
  @@index([targetSkill, status])
}

// ── V27-4 优先级决策（可解释性核心；1:1 候选）──
model TaskPriorityDecision {
  id                   String   @id @default(cuid())
  candidateId          String   @unique
  snapshotId           String
  skillGapId           String?
  /// 权重版本（改权重必须递增，否则历史不可复算）
  weightsVersion       String   @default("v1")
  /// 各因子原始值 0..1（JSON：{urgency,goalRelevance,evidenceStrength,errorRecurrence,prerequisiteReady,timeCost,preferenceFit}）
  factorsJson          String
  /// 加权总分 0..1
  score                Float
  /// P0 | P1 | P2 | P3（由 score 阈值映射，不是角色硬编码）
  priority             String
  /// 一句话推荐原因（模板化生成，人话）
  rationale            String
  /// 若不做的影响（可判则填；null = 无法判断，UI 不得编造）
  consequenceIfSkipped String?
  /// 资格判定（6 值）：ELIGIBLE | BLOCKED_PREREQUISITE | OVER_BUDGET | DUPLICATE
  ///                 | REJECTED_NOT_IN_POOL | REJECTED_AI_OVER_BUDGET
  ///
  /// 后两个是「整条拒绝」而不是「降级保留」，理由（Q2 / F-3）：
  /// - `REJECTED_NOT_IN_POOL`：AI 返回的 `candidateKey` 不在候选池里 —— AI 不得新增池外任务，
  ///   凭空接受一条 AI 造的任务等于绕过"候选池"这个唯一入口；
  /// - `REJECTED_AI_OVER_BUDGET`：AI 建议的分钟数超当日预算 —— **整条拒绝，不按比例裁剪**。
  ///   裁剪会造出一条"任务名说 90 分钟、实际只做 30 分钟"的假记录，比拒绝更糟。
  eligibility          String   @default("ELIGIBLE")
  blockedReason        String?
  createdAt            DateTime @default(now())

  candidate TaskCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  gap       SkillGap?     @relation(fields: [skillGapId], references: [id], onDelete: SetNull)

  @@index([snapshotId, priority])
}

// ── V27-5 阶段 readiness 评审（append-only；stageGate 纯函数结果的持久化）──
model StageReadinessReview {
  id                String   @id @default(cuid())
  snapshotId        String
  stageId           String
  /// ruleVersion 记录当时用的门禁规则版本（H1–H5 口径变更必须递增）
  ruleVersion       String   @default("v2.7.0")
  /// READY_FOR_REVIEW | CONTINUE_CURRENT | NEED_TARGETED_PRACTICE | NEED_MORE_EVIDENCE | USER_APPROVED_TRANSITION
  outcome           String
  /// JSON：H1–H5 逐条 { code, label, current, target, passed }
  criteriaJson      String
  /// JSON string[]：依据的 evidenceIds / retestScheduleIds
  evidenceRefsJson  String?
  /// JSON string[]：未满足项的人话说明
  unmetJson         String?
  /// 用户确认信息（系统只建议，不自动切换）
  userConfirmed     Boolean  @default(false)
  confirmedAt       DateTime?
  confirmedBy       String?
  note              String?
  createdAt         DateTime @default(now())

  snapshot PlanningSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([stageId, createdAt])
  @@index([outcome])
}
