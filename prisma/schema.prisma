// IELTS Learning OS — Prisma schema（设计产物，可直接 `prisma db push`）
// 目标版本：Prisma 6.x（不要升到 7：v7 强制 driver adapter + prisma.config.ts + ESM）
// 约定：
//   1. 业务日期一律 String "YYYY-MM-DD"（SQLite 无 DATE 类型；字符串字典序可比较可索引）
//   2. 时刻一律 DateTime
//   3. 枚举一律 String，取值由 src/lib/constants.ts + zod 约束（SQLite 不支持原生 enum）
//   4. JSON 一律 String（SQLite 不支持标量数组），统一由 src/lib/json.ts 解析
//   5. 派生值（accuracy/completionRate/netMinutes/overdueDays）不落库，一律读模型计算
//
// v2.0 增量（全部为加法，旧代码 + 新库可直接运行）：
//   · 新增 8 表：LearningGoal / SkillAllocationProfile / GoalMilestone /
//     SkillAssessment / IeltsAssessment / EnglishMediatedSession /
//     LearningOutput / EvidenceAttachment
//   · PlanTask / StudySession / StudyRecord 增加 track + primarySkill 快照
//   · StudySession.taskId 改为可空（媒介学习不挂计划任务）
//   · 三目标分别统计：CEFR 评估、IELTS 成绩、媒介学习里程碑物理分表，互不换算
//
// v2.1 增量（全部为加法 + 两个新状态值，旧数据不需要改写）：
//   · 新增 4 表：DailyBudget / WeeklyTarget / WeeklyDayAllocation / PlanVersion，
//     以及单行配置 PlannerSettings（id 恒为 1）
//   · PlanTask 增加 priority / splittable / minChunkMinutes / planVersion /
//     originalScheduledDate / rescheduleReason / deferReason / sourceKind
//   · 任务状态新增 CANCELLED / DEFERRED（两者都不进入完成率失败分母）
//   · UserProfile.dailyMinutes 降级为「v2.0 历史值」，不再作为 v2.1 预算来源：
//     v2.1 预算一律走 DailyBudget → PlannerSettings.weekdayProfiles →
//     PlannerSettings.defaultDailyMinutes（初始建议值 60，且标记为建议）
//   · 「240 分钟是最低计划时长」的假设作废；15 分钟为应急维护模式

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── E1 单用户配置（固定 1 行，id 恒为 1）
model UserProfile {
  id                Int       @id @default(1)
  targetBandOverall Float     @default(6.5)
  targetBandListen  Float?
  targetBandRead    Float?
  targetBandWrite   Float?
  targetBandSpeak   Float?
  /**
   * v2.0 历史字段。v2.1 起**不再**是每日预算来源（预算见 `DailyBudget` 与 `PlannerSettings`），
   * 仅保留用于旧数据回读与设置页展示「v2.0 旧值」，避免静默把 240 当默认预算。
   */
  dailyMinutes      Int       @default(240)
  timezone          String    @default("Asia/Singapore")
  examDate          String?
  weeklyReviewDow   Int       @default(0)
  aiEnabled         Boolean   @default(false)
  lastExportedAt    DateTime?

  // ── v2.0 三目标全局默认 ──
  /**
   * /**
   * /**
   * 长期通用英语目标等级（展示用，非官方认证）。
   */
  cefrTarget        String @default("B2")
  /**
   * 英语媒介学习的默认学科；初始 French，可改。
   */
  mediatedSubject   String @default("French")
  /**
   * 媒介学习的起始强度档：PRE_A2 接触术语 | A2_B1 低强度试学 | B1_PLUS 系统化。
   */
  mediatedStartBand String @default("A2_B1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── E2 阶段（4 行，seed 写入）
model Stage {
  id          String   @id @default(cuid())
  code        String   @unique // S0_PREP|S1_A0_A2|S2_A2_B1|S3_B1_IELTS
  nameZh      String
  estDaysMin  Int
  estDaysMax  Int? // null = 「或更久」
  status      String   @default("NOT_STARTED") // NOT_STARTED|ACTIVE|COMPLETED|SKIPPED
  startedAt   String?
  completedAt String?
  sortOrder   Int      @default(0)
  /**
   * v2.0：阶段 → SOP v2 的 profile_code 映射（PREPARATION / A0_A2 / A2_B1 / B1_B2）。
   * 不改 `code`，避免所有既有引用（constants / 测试 / 页面）全部返工。
   */
  profileCode String? // PREPARATION|A0_A2|A2_B1|B1_B2
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptanceItems StageAcceptanceItem[]
  planTasks       PlanTask[]
  studyRecords    StudyRecord[]
  egiuLessons     EgiuLesson[]
  mistakes        Mistake[]
  sentenceItems   SentenceAnalysis[]

  @@index([status])
  @@index([sortOrder])
}

// ── E3 阶段验收项（每阶段 7 行，seed 写入；定义型子表 → Cascade）
model StageAcceptanceItem {
  id            String   @id @default(cuid())
  stageId       String
  dimension     String // LISTENING|READING|SPEAKING|WRITING|GRAMMAR|VOCAB|SENTENCE
  isRequired    Boolean  @default(true)
  criterionText String // SOP 原文，只读
  myResult      String?
  evidence      String?
  verdict       String   @default("PENDING") // PENDING|PASSED|FAILED
  judgedAt      String?
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, dimension])
  @@index([stageId])
}

// ── E4 计划任务（含实时计时状态；计时以服务端时钟为准）
model PlanTask {
  id              String    @id @default(cuid())
  stageId         String
  planDate        String // YYYY-MM-DD
  module          String // VOCAB_REVIEW|GRAMMAR|LISTENING|READING|SPEAKING|WRITING|SENTENCE|REVIEW_PLAN|EXTENSIVE|MEDIATED|BASELINE_LISTEN|BASELINE_READ|BASELINE_OUTPUT
  skill           String // VOCAB|GRAMMAR|LISTENING|READING|SPEAKING|WRITING|SENTENCE|META|LISTENING_EXT|READING_EXT
  plannedMinutes  Int
  actualMinutes   Int       @default(0) // 快照，真值 = Σ StudySessionDaySplit
  sortOrder       Int       @default(0)
  status          String    @default("TODO") // TODO|IN_PROGRESS|DONE|PARTIAL|MISSED|CANCELLED|DEFERRED
  statusChangedAt DateTime?
  movedFromDate   String?
  movedToDate     String?
  movedCount      Int       @default(0)
  resourceId      String?
  note            String?

  // ── v2.1 自适应计划 ──
  /**
   * /**
   * /**
   * 优先级：P0 到期/逾期复习、P1 当前阶段核心、P2 有证据的弱项/目标差距、P3 拓展。
   * 取值固定 `P0`–`P3`（字符串，SQLite 无 enum）。
   */
  priority              String  @default("P1")
  /**
   * 是否允许分段执行（不可拆的完整模考/整篇写作必须为 false）。
   */
  splittable            Boolean @default(false)
  /**
   * 分段的最小块（分钟），低于它不生成碎片任务。
   */
  minChunkMinutes       Int     @default(5)
  /**
   * 生成该任务时的计划版本；重排时递增，历史版本行保留。
   */
  planVersion           Int     @default(1)
  /**
   * 首次被安排到的日期；顺延/重排后不变，用于追溯原始安排。
   */
  originalScheduledDate String?
  /**
   * 最近一次重排原因（预算变更 / P0 挤压 / 手动延后 …）。
   */
  rescheduleReason      String?
  /**
   * 进入 backlog 的原因（如「P0 超额，按风险分批」）。
   */
  deferReason           String?
  /**
   * 任务来源：REVIEW|CORE|WEAKNESS|EXTENDED|MANUAL|LEGACY（v2.0 迁移行 = LEGACY）。
   */
  sourceKind            String  @default("CORE")

  // ── v2.0 三轨道 ──
  /**
   * /**
   * /**
   * 主轨道。任务必须归属一个主轨道；允许加标签，但不允许一条学习时长被重复计入总时长。
   * GENERAL_ENGLISH | IELTS_PREPARATION | ENGLISH_MEDIATED_LEARNING
   */
  track        String @default("GENERAL_ENGLISH")
  /**
   * 四技能粒度 + 支持性模块。技能时间统计**只看这个字段**（同一任务只有一个主技能），
   * 与 `skill`（模块粒度，含泛听/泛读/复盘）分离，避免两套口径互相污染。
   * LISTENING | READING | SPEAKING | WRITING | FOUNDATION
   */
  primarySkill String @default("FOUNDATION")

  timerStatus             String    @default("IDLE") // IDLE|RUNNING|PAUSED|STOPPED
  timerStartedAt          DateTime?
  timerAccumulatedSeconds Int       @default(0)
  timerLastActiveAt       DateTime?
  timerVersion            Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage                 Stage                       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  resource              Resource?                   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  sessions              StudySession[]
  records               StudyRecord[]
  evidenceRecords       EvidenceRecord[]
  retestSchedules       RetestSchedule[]
  vocabularyAssignments VocabularyAssignment[]
  vocabularySessions    VocabularyPracticeSession[]

  @@index([planDate, sortOrder])
  @@index([stageId])
  @@index([status])
  @@index([timerStatus])
  @@index([resourceId])
  @@index([track])
  @@index([primarySkill])
  @@index([planDate, priority])
  @@index([planVersion])
}

// ── v2.1 B1 每日时间预算（同一日期只有一条当前有效预算）
//
// 「预算」是计划净学习时间的**上限**，既不是实际学习时间，也不是打卡要求。
// 0 分钟 = 休息日 / 未安排学习日：不生成强制任务，也不计入完成率失败分母。
model DailyBudget {
  id                      String   @id @default(cuid())
  date                    String   @unique // YYYY-MM-DD
  /**
   * 计划净学习分钟上限（休息日为 0）。
   */
  plannedAvailableMinutes Int      @default(0)
  /**
   * PRESET | CUSTOM | REST_DAY
   */
  budgetType              String   @default("PRESET")
  /**
   * EMERGENCY|MINIMUM|LIGHT|LIGHT_STANDARD|STANDARD|FOCUSED|DEEP|EXTENDED|CUSTOM|REST
   */
  tierCode                String?
  isRestDay               Boolean  @default(false)
  /**
   * 首次安装的 60 分钟建议值必须标记为建议，不得冒充用户真实可用时间。
   */
  isInitialSuggestion     Boolean  @default(false)
  /**
   * USER | WEEKDAY_TEMPLATE | DEFAULT_SUGGESTION | MIGRATION
   */
  source                  String   @default("USER")
  note                    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([date])
  @@index([isRestDay])
}

// ── v2.1 B2 周总学习目标（每周一行，预算与实际分开统计）
model WeeklyTarget {
  id            String   @id @default(cuid())
  weekStart     String   @unique // ISO 周周一 YYYY-MM-DD
  targetMinutes Int
  /**
   * ACTIVE | ADJUSTED
   */
  status        String   @default("ACTIVE")
  /**
   * 建议来源：USER | SUGGESTION_ACCEPTED。系统建议不得自动写入。
   */
  source        String   @default("USER")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations WeeklyDayAllocation[]

  @@index([weekStart])
}

// ── v2.1 B3 周内每日分配（可含休息日；不要求平均分配）
model WeeklyDayAllocation {
  id               String  @id @default(cuid())
  weeklyTargetId   String
  date             String // YYYY-MM-DD
  availableMinutes Int     @default(0)
  isRestDay        Boolean @default(false)

  weeklyTarget WeeklyTarget @relation(fields: [weeklyTargetId], references: [id], onDelete: Cascade)

  @@unique([weeklyTargetId, date])
  @@index([date])
}

// ── v2.1 B4 规划器全局配置（单行，id 恒为 1）
model PlannerSettings {
  id                  Int      @id @default(1)
  /**
   * 未配置任何日程时的**初始建议**每日分钟数（可编辑，不是强制默认）。
   */
  defaultDailyMinutes Int      @default(60)
  /**
   * 周日..周六 7 个值，JSON 数组；null/0 表示休息日。
   */
  weekdayProfiles     String   @default("[60,60,60,60,60,60,0]")
  /**
   * 任务最小时间粒度（分钟），低于此值不创建任务。
   */
  minTaskMinutes      Int      @default(5)
  /**
   * 周目标分钟数；null = 未设置。
   */
  weeklyTargetMinutes Int?
  /**
   * 优先级规则参数 JSON（P0 上限比例、核心最低保障比例等）。
   */
  priorityPolicy      String   @default("{\"p0CapRatio\":0.6,\"coreMinRatio\":0.3}")
  /**
   * 用户是否亲自保存过本配置。false = 仍是迁移写入的初始建议值，不得当作真实可用时间。
   */
  isUserConfirmed     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── v2.1 B5 计划版本（append-only；保存调整前后快照与幂等键）
model PlanVersion {
  id                    String   @id @default(cuid())
  planDate              String
  version               Int
  /**
   * GENERATE | REPLAN | MANUAL_ADJUST
   */
  changeSource          String
  reason                String?
  /**
   * 本次生成/重排使用的有效预算分钟。
   */
  budgetMinutes         Int      @default(0)
  /**
   * 变更发生时的当日已发生净学习分钟（用于校验「事实不被改写」）。
   */
  actualMinutesAtChange Int      @default(0)
  beforeSnapshot        String? // JSON：变更前的任务快照
  afterSnapshot         String? // JSON：变更后的任务快照
  /**
   * 同一生成请求的幂等键；重复请求返回已有结果，不重复建任务。
   */
  idempotencyKey        String?  @unique
  createdAt             DateTime @default(now())

  @@unique([planDate, version])
  @@index([planDate])
}

// ── E5 计时段（append-only；一 task 可多段）
//
// v2.0 关键改动：`taskId` 由必填改为可空。
// 原因：英语媒介学习允许不经过「计划任务」直接记录一次学习（SOP §7.2），
// 但它仍必须落在这张表里，才能保证「总净时长 = Σ DaySplit」这条唯一口径不破。
// 若为它另建带 duration 的表，然后汇总时再相加，就是双重计时。
model StudySession {
  id               String   @id @default(cuid())
  taskId           String?
  startedAt        DateTime
  endedAt          DateTime
  activeMinutes    Int
  idleMinutes      Int      @default(0)
  countRatio       Float    @default(0) // clamp(active/planned, 0, 1.5)
  anomalyFlag      Boolean  @default(false)
  anomalyReason    String?
  terminatedReason String // COMPLETED|PAUSED|ABANDONED|MOVED|TIMEOUT
  sessionDate      String // 占比最大的自然日

  // ── v2.0：轨道与主技能快照（聚合不再必须 join task，task 可空时也能归集） ──
  track      String  @default("GENERAL_ENGLISH")
  /**
   * LISTENING | READING | SPEAKING | WRITING | FOUNDATION
   */
  skill      String  @default("FOUNDATION")
  /**
   * 若本段来自英语媒介学习，指向那条记录（1:1 反向）。
   */
  mediatedId String?

  createdAt DateTime @default(now())

  task               PlanTask?                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mediated           EnglishMediatedSession?     @relation(fields: [mediatedId], references: [id], onDelete: SetNull)
  daySplits          StudySessionDaySplit[]
  evidenceRecords    EvidenceRecord[]
  vocabularySessions VocabularyPracticeSession[]

  @@index([taskId])
  @@index([sessionDate])
  @@index([track])
  @@index([skill])
  @@index([mediatedId])
}

// 跨零点分钟占比拆分 → 保证「日净时长」不虚高（日净时长只从这张表求和）
model StudySessionDaySplit {
  id        String @id @default(cuid())
  sessionId String
  date      String
  minutes   Int

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, date])
  @@index([date])
}

// ── E6 学习记录（核心，软删除）
model StudyRecord {
  id               String  @id @default(cuid())
  stageId          String
  taskId           String?
  recordDate       String
  skill            String
  resourceId       String?
  chapter          String?
  content          String
  plannedMinutes   Int     @default(0)
  actualMinutes    Int     @default(0)
  status           String  @default("DONE")
  totalQuestions   Int     @default(0)
  correctQuestions Int     @default(0)
  difficulty       String? // EASY|MEDIUM|HARD
  outputText       String? // G2 可检查产出
  problemText      String?
  errorTypes       String? // JSON string[]
  nextReviewDate   String?
  ext              String? // JSON，分科扩展（听力6/阅读6/口语8/写作7）

  // ── v2.0 三轨道 ──
  track        String @default("GENERAL_ENGLISH")
  /**
   * 四技能粒度快照（LISTENING|READING|SPEAKING|WRITING|FOUNDATION）。
   */
  primarySkill String @default("FOUNDATION")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  stage         Stage              @relation(fields: [stageId], references: [id], onDelete: Restrict)
  task          PlanTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  resource      Resource?          @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  mistakes      Mistake[]
  sentenceItems SentenceAnalysis[]
  revisions     RecordRevision[]
  outputs       LearningOutput[]

  @@index([recordDate])
  @@index([skill, recordDate])
  @@index([stageId])
  @@index([archivedAt])
  @@index([resourceId])
  @@index([track])
}

// ── P1-03 字段级修订历史（append-only）
model RecordRevision {
  id          String   @id @default(cuid())
  recordId    String
  field       String
  beforeValue String?
  afterValue  String?
  changedAt   DateTime @default(now())

  record StudyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, changedAt])
}

// ── E7 EGIU 单元（只存当前态；历史在 EgiuReview）
model EgiuLesson {
  id             String    @id @default(cuid())
  stageId        String
  resourceId     String?
  book           String    @default("Essential Grammar in Use")
  version        String?
  unitNo         String
  knowledgePoint String
  currentColor   String    @default("PENDING") // PENDING|GREEN|YELLOW|RED（= 最近一次有效判定）
  currentScore   Float?
  currentReason  String?
  learnedDate    String // D0，复习点起算日（补录时为 user 填的学习日）
  greenStreak    Int       @default(0)
  masteredAt     DateTime?
  inLowFreqPool  Boolean   @default(false)
  nextReviewDate String?
  retestCount    Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stage    Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  resource Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  reviews  EgiuReview[]

  @@index([stageId])
  @@index([currentColor])
  @@index([nextReviewDate])
  @@index([resourceId, unitNo])
}

// ── E8 复测记录（append-only，禁止覆盖；UI 无 update/delete 入口）
model EgiuReview {
  id               String   @id @default(cuid())
  lessonId         String
  reviewDate       String
  reviewStage      String // D0|D1|D3|D7|D14|D21|D30|MANUAL
  totalQuestions   Int
  correctQuestions Int
  explainOk        Boolean
  sentencesCount   Int
  coreRuleOk       Boolean
  judgedColor      String
  judgeReason      String // 命中规则，UI 必须原样展示
  judgeBranch      String // ZERO|OVERRIDE|FULL|LOW_VOLUME
  score            Float? // 仅 LOW_VOLUME 分支的 S
  errorBreakdown   String? // JSON {rule_unclear,memory_confusion,careless,vocab}
  reviewTaskId     String?
  createdAt        DateTime @default(now())

  lesson EgiuLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, reviewDate])
  @@index([reviewDate])
}

// ── E9 错题（软删除）
model Mistake {
  id                 String    @id @default(cuid())
  stageId            String
  sourceType         String // EGIU_REVIEW|STUDY_RECORD|MANUAL|VOCAB
  sourceId           String?
  studyRecordId      String?
  originalQuestion   String
  myAnswer           String?
  correctAnswer      String
  errorReason        String
  knowledgePoint     String // 薄弱点聚合键
  errorCategory      String // RULE_NOT_UNDERSTOOD|MEMORY_CONFUSION|VOCAB_UNKNOWN|WORD_ORDER|CARELESS|OTHER
  ieltsErrorCategory String? // VOCAB|LOCATING|COMPREHENSION|ATTENTION|STRATEGY（仅 S3）
  reviewCount        Int       @default(0)
  lastReviewAt       String?
  nextReviewAt       String?
  isMastered         Boolean   @default(false)
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  stage       Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  studyRecord StudyRecord? @relation(fields: [studyRecordId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([knowledgePoint])
  @@index([errorCategory])
  @@index([isMastered])
  @@index([nextReviewAt])
}

// ── E10 统一复习调度（唯一入口，4 种 targetType 共用，禁止为各类型另建调度器）
model ReviewTask {
  id             String    @id @default(cuid())
  targetType     String // EGIU_LESSON|MISTAKE|VOCAB_WORD|GRAMMAR_POINT
  targetId       String
  targetLabel    String // 冗余展示名，避免多态 join / N+1
  knowledgePoint String?
  intervalCode   String // D1|D3|D7|D14|D21|D30|MANUAL|LOW_FREQ_30
  dueDate        String
  status         String    @default("PENDING") // PENDING|DONE|SKIPPED|SUPERSEDED
  estMinutes     Int       @default(5)
  result         String? // PASS|FAIL（status=DONE 时必填）
  completedAt    DateTime?
  skippedReason  String?
  supersededById String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([targetType, targetId, intervalCode, dueDate])
  @@index([status, dueDate])
  @@index([targetType, targetId])
  @@index([dueDate])
}

// ── E11 词汇（软删除；三档掌握度不可合并统计）
model VocabWord {
  id              String    @id @default(cuid())
  word            String    @unique
  phonetic        String?
  partOfSpeech    String?
  meaningZh       String
  meaningEn       String?
  collocation     String?
  exampleSentence String?
  source          String    @default("MANUAL") // Oxford3000|MANUAL
  learnedDate     String
  mastery         String    @default("RECOGNIZE_ONLY") // RECOGNIZE_ONLY|COMPREHEND|ACTIVE_USE
  lastReviewAt    String?
  nextReviewAt    String?
  isNew           Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quizItems VocabQuizItem[]

  @@index([learnedDate])
  @@index([mastery])
  @@index([archivedAt])
  @@index([nextReviewAt])
}

// 随机抽测会话（append-only）
model VocabQuiz {
  id               String   @id @default(cuid())
  quizDate         String
  sampleSize       Int
  weightedAccuracy Float? // Σ权重 / 词数；样本 0 → null
  recommendation   String?
  createdAt        DateTime @default(now())

  items VocabQuizItem[]

  @@index([quizDate])
}

model VocabQuizItem {
  id         String  @id @default(cuid())
  quizId     String
  wordId     String?
  word       String
  selfRating String // RECOGNIZE_ONLY|COMPREHEND|ACTIVE_USE
  weight     Float // 0.3 | 0.7 | 1.0

  quiz    VocabQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  wordRef VocabWord? @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([quizId])
}

// ── E12 句子成分（component 与 pos 两个独立取值集，不可复用同一字段）
model SentenceAnalysis {
  id             String    @id @default(cuid())
  stageId        String
  sentenceEn     String
  sentenceZh     String?
  tokens         String // JSON [{text,component,pos}]
  isCorrect      Boolean   @default(true)
  errorReason    String? // isCorrect=false 时必填（应用层校验）
  patternTag     String? // FIVE_PATTERNS|RELATIVE_CLAUSE|ADVERBIAL_CLAUSE|NON_FINITE|PASSIVE
  sourceRecordId String?
  sentenceDate   String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stage        Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sourceRecord StudyRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([sentenceDate])
}

// ── E13 周复盘（(isoYear, isoWeek) 唯一）
model WeeklyReview {
  id             String    @id @default(cuid())
  isoYear        Int
  isoWeek        Int
  weekStart      String // 周一
  weekEnd        String // 周日
  metrics        String // JSON：13 项 {auto, override, overriddenAt}
  isPartial      Boolean   @default(false)
  top3Weaknesses String // JSON 固定 3 项 [{name,score,evidence,manual}]
  reviewNote     String?
  exportedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([isoYear, isoWeek])
  @@index([weekStart])
}

// ── E14 资源库（8 类初始资源由 seed 写入；代码内禁止出现资源名枚举）
model Resource {
  id               String    @id @default(cuid())
  name             String
  subject          String // GRAMMAR|VOCAB|PRONUNCIATION|LISTENING|READING|SPEAKING|WRITING|EXAM
  type             String // BOOK|WORDLIST|WEBSITE|AUDIO_SERIES|GRADED_READER|EXAM_PAPER
  applicableStages String    @default("[\"S1\"]") // JSON string[]
  version          String?
  totalUnits       Int?
  currentUnit      Int?
  startDate        String?
  finishDate       String?
  url              String?
  note             String?
  isPrimary        Boolean   @default(false) // SOP：每项能力固定一个主材料
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  planTasks    PlanTask[]
  studyRecords StudyRecord[]
  egiuLessons  EgiuLesson[]

  @@index([subject])
  @@index([archivedAt])
}

// ── 辅助：阶段流转日志（append-only，只增不删）
model StageTransitionLog {
  id               String   @id @default(cuid())
  fromStageCode    String?
  toStageCode      String
  decidedAt        DateTime @default(now())
  decidedBy        String // SYSTEM_SUGGESTED|USER
  reason           String
  evidenceSnapshot String? // JSON
}

// ── 辅助：当日总结
model DailySummary {
  id                    String   @id @default(cuid())
  summaryDate           String   @unique
  netMinutes            Int      @default(0)
  completionRateByTime  Float?
  completionRateByCount Float?
  outputs               String? // JSON
  issues                String? // JSON
  draftText             String?
  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ── P1-07 AI 建议（与学习成绩物理分区，UI 强制展示 basis）
model AiSuggestion {
  id        String   @id @default(cuid())
  scope     String // WEEKLY|WEAKNESS|PLAN
  refKey    String?
  status    String   @default("unavailable") // available|unavailable
  title     String
  body      String
  basis     String? // 依据
  provider  String?
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.0 三轨道模型
// ══════════════════════════════════════════════════════════════════════════════
//
// 三条轨道必须分别统计、分别验收，**不生成混合「总能力分」**。
// CEFR 估计（SkillAssessment）、IELTS 成绩（IeltsAssessment）与媒介学习里程碑
// （GoalMilestone + EnglishMediatedSession）物理分表存储，代码层面也不提供互相换算。

// ── V1 学习目标（三类各一行：GENERAL_ENGLISH / IELTS / ENGLISH_MEDIATED_LEARNING）
model LearningGoal {
  id           String   @id @default(cuid())
  /**
   * GENERAL_ENGLISH | IELTS | ENGLISH_MEDIATED_LEARNING
   */
  goalType     String   @unique
  name         String
  /**
   * 目标值：通用英语为 CEFR 等级（B2）；IELTS 为总分（6.5）；媒介学习为里程碑数或等级描述。
   */
  targetValue  String?
  /**
   * 雅思单项最低分（仅 IELTS 目标使用；其余为 null）。
   */
  minListening Float?
  minReading   Float?
  minWriting   Float?
  minSpeaking  Float?
  targetDate   String? // YYYY-MM-DD，可空
  /**
   * ACTIVE | ACHIEVED | PAUSED
   */
  status       String   @default("ACTIVE")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  milestones GoalMilestone[]

  @@index([status])
  @@index([goalType])
}

// ── V2 四技能配比（阶段级，可追溯：改配置=插新行 + 旧行 isActive=false）
model SkillAllocationProfile {
  id            String   @id @default(cuid())
  /**
   * PREPARATION | A0_A2 | A2_B1 | B1_B2 | IELTS_INTENSIVE
   */
  profileCode   String
  /**
   * GENERAL_ENGLISH | IELTS_PREPARATION（IELTS_INTENSIVE 专用）
   */
  track         String   @default("GENERAL_ENGLISH")
  listeningPct  Int
  readingPct    Int
  speakingPct   Int
  writingPct    Int
  effectiveFrom String // YYYY-MM-DD
  isActive      Boolean  @default(true)
  /**
   * 变更原因（审计要求：权重修改必须留痕）。
   */
  changeReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileCode, isActive])
  @@index([track, isActive])
}

// ── V3 目标里程碑（每个目标自己的，不与其他目标共享完成状态）
model GoalMilestone {
  id            String    @id @default(cuid())
  goalId        String
  /**
   * 稳定编码，用于去重与幂等 seed（如 GE_A2_EXIT / IELTS_BAND_6_5 / MEDIATED_FRENCH_BASICS）
   */
  milestoneCode String
  title         String
  description   String?
  /**
   * 目标阈值（数字或等级文本，展示用）。
   */
  target        String?
  /**
   * PENDING | ACHIEVED | FAILED
   */
  status        String    @default("PENDING")
  completedAt   DateTime?
  /**
   * 证据 ID 列表（JSON string[]，指向 SkillAssessment / IeltsAssessment / EnglishMediatedSession / LearningOutput）。
   */
  evidenceIds   String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  goal LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, milestoneCode])
  @@index([goalId, status])
}

// ── V4 CEFR 能力评估（按技能独立；学习时长不得推断等级）
model SkillAssessment {
  id             String   @id @default(cuid())
  /**
   * LISTENING | READING | SPEAKING | WRITING
   */
  skill          String
  /**
   * 估计等级：A1|A2|B1|B2|C1（个人能力估计，**不是官方认证**）。
   */
  cefrLevel      String
  /**
   * SELF | TEST | EXTERNAL | AI_ESTIMATE
   */
  assessmentType String
  /**
   * 分数或量表描述（自由文本，便于填「雅思听力 6.0」「教师反馈 B1+」）。
   */
  score          String?
  assessDate     String // YYYY-MM-DD
  /**
   * SELF | TEACHER | EXAM | AI | OTHER
   */
  assessor       String   @default("SELF")
  /**
   * 1..5 置信度（样本量/来源可靠性）。
   */
  confidence     Int      @default(3)
  evidenceId     String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([skill, assessDate])
  @@index([cefrLevel])
  @@index([assessmentType])
}

// ── V5 IELTS 成绩（正式考试与模考同表，靠 testType 区分；**不参与 CEFR 计算**）
model IeltsAssessment {
  id            String   @id @default(cuid())
  testDate      String // YYYY-MM-DD
  /**
   * OFFICIAL（正式考试）| MOCK（模考）| PRACTICE（单项练习）
   */
  testType      String
  overallBand   Float
  listeningBand Float?
  readingBand   Float?
  writingBand   Float?
  speakingBand  Float?
  /**
   * 来源：Cambridge IELTS 19 Test 2 / BC 官方 / 机构模考 …
   */
  source        String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([testDate])
  @@index([testType])
}

// ── V6 英语媒介学习记录（通过英语学法语等新知识）
//
// 定位：这是**跨技能应用**，不是第五项语言技能。
// `primarySkill` 必须是四项之一；时长落在 `StudySession`（同一条时长只计一次），
// 本表的 `durationMinutes` 只是「这条记录声称的时长」，与 session 交叉校验，
// **绝不参与任何总量求和**。
model EnglishMediatedSession {
  id                    String   @id @default(cuid())
  sessionDate           String // YYYY-MM-DD
  /**
   * 所学学科，初始 French，可扩展为任意主题。
   */
  subject               String   @default("French")
  /**
   * 具体主题：French present tense / French articles …
   */
  topic                 String
  /**
   * 英文材料标题与链接（课程/视频/教材）。
   */
  sourceTitle           String?
  sourceUrl             String?
  /**
   * COURSE | VIDEO | TEXTBOOK | ARTICLE | PODCAST | OTHER
   */
  sourceType            String   @default("COURSE")
  /**
   * 四技能之一：本段学习主要锻炼哪项语言技能。
   */
  primarySkill          String
  /**
   * 记录的时长（分钟）；真值以 StudySession 为准，本字段用于表内自洽校验。
   */
  durationMinutes       Int
  /**
   * 材料语言难度自评：A2 | B1 | B2 | C1
   */
  languageLevel         String?
  /**
   * 理解情况：FULL（能说出主旨与例子）| PARTIAL（需字幕/翻译）| LOW（无法理解）
   */
  understanding         String
  /**
   * 翻译依赖：NONE | SUBTITLE_EN | ZH_ASSIST | HEAVY_ZH
   */
  translationDependency String
  /**
   * 英文笔记（正文）。
   */
  notesEn               String?
  /**
   * 英文摘要（80–120 词级别的产出）。
   */
  summaryEn             String?
  /**
   * 提出的问题（英文）。
   */
  questionsEn           String?
  /**
   * A2_B1 试学 / B1_PLUS 系统化 —— 用于判断阶段强度是否达标。
   */
  intensity             String   @default("A2_B1")
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sessions        StudySession[]
  outputs         LearningOutput[]
  evidenceRecords EvidenceRecord[]

  @@index([sessionDate])
  @@index([subject])
  @@index([primarySkill])
  @@index([understanding])
  @@index([translationDependency])
}

// ── V7 学习产出（英文笔记/摘要/问题/录音/写作；可挂 record 或 mediated session）
model LearningOutput {
  id           String   @id @default(cuid())
  /**
   * 二选一挂载（应用层校验至少一个非空）。
   */
  recordId     String?
  mediatedId   String?
  /**
   * NOTE_EN | SUMMARY_EN | QUESTION_EN | ESSAY | RECORDING | MINDMAP
   */
  outputType   String
  /**
   * 正文（文本类产出）；文件类产出走 `uri`。
   */
  content      String?
  uri          String?
  /**
   * DRAFT | REVIEWED | ACCEPTED
   */
  reviewStatus String   @default("DRAFT")
  createdAt    DateTime @default(now())

  record   StudyRecord?            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  mediated EnglishMediatedSession? @relation(fields: [mediatedId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([mediatedId])
  @@index([outputType])
}

// ── V8 证据附件（录音/写作/评分单/课程材料的元数据；不存二进制）
model EvidenceAttachment {
  id           String  @id @default(cuid())
  fileUri      String
  mimeType     String?
  /**
   * RECORDING | WRITING | SCORE_SHEET | COURSE_MATERIAL | SCREENSHOT | OTHER
   */
  evidenceType String
  /**
   * 多态挂载：SKILL_ASSESSMENT | IELTS_ASSESSMENT | MEDIATED_SESSION | STUDY_RECORD | GOAL_MILESTONE | EVIDENCE_RECORD
   */
  linkedEntity String
  linkedId     String
  note         String?

  // ── v2.2：附件元数据补全（默认私有 + 外发需同意） ──
  sizeBytes     Int?
  checksum      String?
  /**
   * PRIVATE | SHAREABLE | METADATA_ONLY
   */
  privacyLevel  String  @default("PRIVATE")
  /**
   * NOT_REQUIRED | GRANTED | DENIED（第三方 AI/云存储外发同意状态）
   */
  consentStatus String  @default("NOT_REQUIRED")

  createdAt DateTime @default(now())

  evidenceRecords EvidenceRecord[]

  @@index([linkedEntity, linkedId])
  @@index([evidenceType])
  @@index([privacyLevel])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.2 Evidence-Based Learning（全部为加法；不改既有表结构与数据）
// ══════════════════════════════════════════════════════════════════════════════

// ── EV1 证据记录（统一证据模型；原始样本不可覆盖，版本用 parentEvidenceId 串联）
model EvidenceRecord {
  id               String    @id @default(cuid())
  /**
   * LISTENING | READING | SPEAKING | WRITING | GRAMMAR | VOCABULARY
   */
  skill            String
  /**
   * BASELINE | ASSISTED | IMMEDIATE_RETEST | DELAYED_RETEST | APPLIED_TASK | TRANSFER
   */
  evidenceType     String
  /**
   * QUICK | STANDARD | FULL
   */
  level            String    @default("QUICK")
  /**
   * 版本链：指向同链上一版本；链根（BASELINE / 独立 Quick 记录）为 null。
   */
  parentEvidenceId String?
  /**
   * 链根 ID（冗余便于整链查询；由应用层维护，链根记录也为 null）。
   */
  chainRootId      String?
  taskId           String?
  sessionId        String?
  mediatedId       String?
  artifactId       String?
  /**
   * v2.4：关联的 AI 学习会话。删除会话时置空，证据本身保留。
   */
  aiSessionId      String?
  /**
   * 任务与条件快照 JSON：prompt / materialSource / timeLimitMinutes / toolsAllowed / audience / environment
   */
  conditionJson    String?
  /**
   * 可见产出正文（Quick Evidence 可只填这一项）。
   */
  outputText       String?
  /**
   * 内部 0–2 评分：0 未完成/无证据；1 部分/依赖提示/不稳定；2 标明条件下独立完成。
   */
  score            Int?
  scoreReason      String?
  /**
   * 评分维度 JSON（如 { recognition, explanation, controlledUse, independentUse }）。
   */
  dimensionsJson   String?
  /**
   * 证据位置：句子 / 段落 / 音频时间戳 / 题号。
   */
  evidenceAnchor   String?
  /**
   * A0–A4（A0 无辅助；A4 代写/代答，绝不计为独立产出）。
   */
  assistanceLevel  String    @default("A0")
  /**
   * SELF | TEACHER | PEER | AI | EXAM
   */
  assessorType     String    @default("SELF")
  /**
   * LOW | MEDIUM | HIGH
   */
  confidence       String    @default("MEDIUM")
  /**
   * PRIVATE | SHAREABLE | METADATA_ONLY
   */
  privacyLevel     String    @default("PRIVATE")
  note             String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parent   EvidenceRecord?  @relation("EvidenceChain", fields: [parentEvidenceId], references: [id], onDelete: SetNull)
  children EvidenceRecord[] @relation("EvidenceChain")

  task      PlanTask?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  session   StudySession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  mediated  EnglishMediatedSession? @relation(fields: [mediatedId], references: [id], onDelete: SetNull)
  artifact  EvidenceAttachment?     @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  aiSession AILearningSession?      @relation(fields: [aiSessionId], references: [id], onDelete: SetNull)

  diagnoses         BarrierDiagnosis[]
  interventionsPre  InterventionPlan[]       @relation("InterventionPre")
  interventionsPost InterventionPlan[]       @relation("InterventionPost")
  retests           RetestSchedule[]         @relation("RetestParent")
  completedRetests  RetestSchedule[]         @relation("RetestCompleted")
  aiUsage           AIUsageRecord[]          @relation("AIUsageEvidence")
  aiUsageBefore     AIUsageRecord[]          @relation("AIUsageBefore")
  aiUsageAfter      AIUsageRecord[]          @relation("AIUsageAfter")
  vocabularyLinks   VocabularyEvidenceLink[]

  @@index([skill, evidenceType])
  @@index([parentEvidenceId])
  @@index([chainRootId])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([privacyLevel])
  @@index([aiSessionId])
}

// ── EV2 分项能力画像（每技能一行；不做四项平均，也不换算 CEFR 官方等级）
model SkillProfile {
  id             String   @id @default(cuid())
  /**
   * LISTENING | READING | SPEAKING | WRITING
   */
  skill          String   @unique
  /**
   * Pre-A1 | A1 | A2 | B1 | B2 | C1；null = 待评估
   */
  direction      String?
  /**
   * LOW | MEDIUM | HIGH
   */
  confidence     String   @default("LOW")
  /**
   * JSON string[]：EvidenceRecord ID 列表（证据依据）
   */
  evidenceBasis  String?
  lastAssessedAt String?
  reviewDueAt    String?
  /**
   * 本次证据不能说明什么（明确边界）。
   */
  doNotInfer     String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── EV3 障碍诊断（按技能的错误类型 + 样本锚点；每轮只聚焦一个主障碍）
model BarrierDiagnosis {
  id             String    @id @default(cuid())
  skill          String
  /**
   * 取值由 BARRIER_TYPES_BY_SKILL 约束（见 constants）
   */
  barrierType    String
  evidenceId     String?
  /**
   * 样本位置：句子 / 段落 / 时间戳 / 题号
   */
  evidenceAnchor String?
  impact         String
  confidence     String    @default("MEDIUM")
  selectedFocus  Boolean   @default(false)
  /**
   * ACTIVE | RESOLVED | SUPERSEDED
   */
  status         String    @default("ACTIVE")
  cycleId        String?
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  evidence      EvidenceRecord?    @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  cycle         LearningCycle?     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  interventions InterventionPlan[]

  @@index([skill, selectedFocus])
  @@index([cycleId])
  @@index([status])
}

// ── EV4 定向修复计划（一条主障碍 → 若干修复任务 + 成功标准 + 前后样本）
model InterventionPlan {
  id               String   @id @default(cuid())
  barrierId        String
  action           String
  successCriteria  String
  /**
   * A0–A4：修复时允许的支架级别；复测时必须撤除
   */
  scaffoldLevel    String   @default("A1")
  estimatedMinutes Int      @default(15)
  /**
   * PLANNED | IN_PROGRESS | COMPLETED | ABANDONED
   */
  status           String   @default("PLANNED")
  preEvidenceId    String?
  postEvidenceId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  barrier      BarrierDiagnosis @relation(fields: [barrierId], references: [id], onDelete: Cascade)
  preEvidence  EvidenceRecord?  @relation("InterventionPre", fields: [preEvidenceId], references: [id], onDelete: SetNull)
  postEvidence EvidenceRecord?  @relation("InterventionPost", fields: [postEvidenceId], references: [id], onDelete: SetNull)

  @@index([barrierId, status])
  @@index([status])
}

// ── EV5 技能型复测调度（知识型复习仍用 ReviewTask，两套状态互不复用）
model RetestSchedule {
  id                  String    @id @default(cuid())
  parentEvidenceId    String
  /**
   * IMMEDIATE | DELAYED | APPLIED | TRANSFER
   */
  retestType          String
  dueDate             String
  /**
   * PENDING | DONE | SKIPPED | SUPERSEDED
   */
  status              String    @default("PENDING")
  estMinutes          Int       @default(10)
  completedEvidenceId String?
  planTaskId          String?
  /**
   * 幂等键：parent + type + dueDate，重复生成返回已有行
   */
  idempotencyKey      String    @unique
  note                String?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parent    EvidenceRecord  @relation("RetestParent", fields: [parentEvidenceId], references: [id], onDelete: Cascade)
  completed EvidenceRecord? @relation("RetestCompleted", fields: [completedEvidenceId], references: [id], onDelete: SetNull)
  planTask  PlanTask?       @relation(fields: [planTaskId], references: [id], onDelete: SetNull)

  @@unique([parentEvidenceId, retestType, dueDate])
  @@index([status, dueDate])
  @@index([parentEvidenceId])
}

// ── EV6 90 天学习周期（1–14 校准 / 15–56 积累 / 57–90 交付；中断可暂停恢复）
model LearningCycle {
  id           String    @id @default(cuid())
  title        String
  goal         String
  deliverable  String?
  startDate    String
  endDate      String
  /**
   * CALIBRATION | BUILD | DELIVER | COMPLETED | PAUSED
   */
  status       String    @default("CALIBRATION")
  /**
   * JSON string[]：基线证据 ID 列表
   */
  baselineRefs String?
  /**
   * 中断恢复记录（客观原因 + 缩小后的下一步，不堆任务）
   */
  recoveryNote String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  weeklyFocus WeeklyFocus[]
  diagnoses   BarrierDiagnosis[]

  @@index([status, startDate])
}

// ── EV7 每周主问题（一个周期内每周一行；一个输入 / 一项输出 / 一次反馈 / 一项迁移证据）
model WeeklyFocus {
  id                 String   @id @default(cuid())
  cycleId            String
  weekIndex          Int
  weekStart          String
  focusQuestion      String
  inputText          String?
  outputText         String?
  feedbackText       String?
  transferEvidenceId String?
  nextDecision       String?
  /**
   * OPEN | REVIEWED
   */
  status             String   @default("OPEN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cycle LearningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, weekIndex])
  @@index([weekStart])
}

// ── EV8 AI 使用日志（辅助级别 A0–A4；A4 绝不计为独立产出）
model AIUsageRecord {
  id                String   @id @default(cuid())
  evidenceId        String?
  beforeEvidenceId  String?
  afterEvidenceId   String?
  toolName          String
  modelVersion      String?
  /**
   * A0 | A1 | A2 | A3 | A4
   */
  assistanceLevel   String
  /**
   * HINT | EXPLAIN | CORRECT | REWRITE | GENERATE | SCORE | TRANSLATE | OTHER
   */
  actionType        String
  purpose           String?
  inputRef          String?
  outputRef         String?
  /**
   * ADOPTED | PARTIAL | REJECTED
   */
  adoptedOrRejected String   @default("ADOPTED")
  userNote          String?
  createdAt         DateTime @default(now())

  evidence       EvidenceRecord? @relation("AIUsageEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  beforeEvidence EvidenceRecord? @relation("AIUsageBefore", fields: [beforeEvidenceId], references: [id], onDelete: SetNull)
  afterEvidence  EvidenceRecord? @relation("AIUsageAfter", fields: [afterEvidenceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([assistanceLevel])
  @@index([evidenceId])
}

// ── EV9 方法论资料库（外部资源仅存元数据 + 链接 + 用户自己的笔记；不复制正文）
model ResourceReference {
  id            String   @id @default(cuid())
  title         String
  creator       String?
  url           String   @unique
  /**
   * REPO | ARTICLE | TEMPLATE | GUIDE
   */
  resourceType  String   @default("ARTICLE")
  /**
   * P0 | P1 | P2
   */
  priority      String   @default("P1")
  /**
   * 页面显示的更新时间（可获得时）；无法获得则为 null
   */
  sourceUpdated String?
  accessedAt    String?
  /**
   * 许可说明（如 CC BY-NC 4.0 正文 / MIT 站点代码）
   */
  licenseNote   String?
  /**
   * JSON string[]：适用阶段，如 ["A0_A2","A2_B1"]
   */
  stageFit      String?
  /**
   * ACTIVE | ARCHIVED
   */
  status        String   @default("ACTIVE")
  /**
   * 分类：入口 | 诊断 | 证据 | 复盘 | AI | 工具
   */
  category      String?
  /**
   * 用户自己的摘要（不复制原文）
   */
  summary       String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  readingLogs ResourceReadingLog[]

  @@index([priority, sortOrder])
  @@index([status])
}

// ── EV10 资源阅读日志（每资源一行当前状态；个人摘要 + 计划实践 + 关联证据）
model ResourceReadingLog {
  id                String   @id @default(cuid())
  resourceId        String   @unique
  /**
   * NOT_STARTED | READING | SUMMARIZED | APPLIED | DONE
   */
  status            String   @default("NOT_STARTED")
  personalSummary   String?
  plannedAction     String?
  appliedEvidenceId String?
  lastReadAt        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resource ResourceReference @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ── EV11 应用迁移版本表（版本化迁移脚本写入；db push 建库时为空）
model AppMigration {
  id        String   @id @default(cuid())
  version   String   @unique
  checksum  String?
  appliedAt DateTime @default(now())
  note      String?
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.3 Vocabulary / TypeWords Integration（全部为加法；既有 VocabWord 保持不变）
// ══════════════════════════════════════════════════════════════════════════════

// ── V1 词汇来源（每个词表/教材/个人来源都要能追溯许可） ──
model VocabularySource {
  id         String    @id @default(cuid())
  /**
   * TEXTBOOK | EXAM | MATERIAL | MANUAL | IMPORT | LEGACY
   */
  sourceType String    @default("IMPORT")
  title      String
  edition    String?
  license    String?
  licenseUrl String?
  url        String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items       VocabularyItem[]
  memberships VocabularyItemSource[]
  decks       VocabularyDeck[]

  @@index([sourceType])
  @@index([archivedAt])
}

// ── V2 统一词条（lemma + POS + senseKey 才唯一；同形异义不合并） ──
model VocabularyItem {
  id               String    @id @default(cuid())
  lemma            String
  displayForm      String?
  normalizedLemma  String
  /**
   * 空串 = 词性未知；不用 NULL，保证 SQLite 唯一约束可生效。
   */
  pos              String    @default("")
  language         String    @default("en")
  /**
   * 同形异义的稳定区分键；默认 default。
   */
  senseKey         String    @default("default")
  phoneticUk       String?
  phoneticUs       String?
  definitionZh     String?
  definitionEn     String?
  examplesJson     String?
  collocationsJson String?
  synonymsJson     String?
  wordFamilyJson   String?
  tagsJson         String?
  sourceId         String
  sourceRef        String?
  license          String?
  externalRefsJson String?
  /**
   * ACTIVE | ARCHIVED
   */
  status           String    @default("ACTIVE")
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  source        VocabularySource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  memberships   VocabularyItemSource[]
  deckItems     VocabularyDeckItem[]
  mappings      ExternalWordMapping[]
  assignments   VocabularyAssignmentItem[] @relation("AssignmentItems")
  attempts      VocabularyAttempt[]
  knowledge     VocabularyKnowledgeState[]
  evidenceLinks VocabularyEvidenceLink[]

  @@unique([language, normalizedLemma, pos, senseKey])
  @@index([lemma])
  @@index([normalizedLemma])
  @@index([sourceId])
  @@index([status])
  @@index([archivedAt])
}

// ── V3 词条多来源归属（同一词条来自不同词书时保留全部来源） ──
model VocabularyItemSource {
  id        String   @id @default(cuid())
  itemId    String
  sourceId  String
  sourceRef String   @default("")
  note      String?
  createdAt DateTime @default(now())

  item   VocabularyItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source VocabularySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([itemId, sourceId, sourceRef])
  @@index([sourceId])
}

// ── V4 可分发 Deck ──
model VocabularyDeck {
  id             String    @id @default(cuid())
  title          String
  targetStage    String?
  language       String    @default("en")
  tagsJson       String?
  version        Int       @default(1)
  dailyNewTarget Int       @default(10)
  reviewCap      Int       @default(40)
  externalDeckId String?
  lastSyncedAt   DateTime?
  sourceId       String?
  /**
   * ACTIVE | ARCHIVED
   */
  status         String    @default("ACTIVE")
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  source      VocabularySource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items       VocabularyDeckItem[]
  assignments VocabularyAssignment[]
  mappings    ExternalWordMapping[]

  @@index([status])
  @@index([targetStage])
  @@index([archivedAt])
}

model VocabularyDeckItem {
  id        String   @id @default(cuid())
  deckId    String
  itemId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  deck VocabularyDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  item VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([deckId, itemId])
  @@index([deckId, sortOrder])
  @@index([itemId])
}

// ── V5 外部词条映射（映射不等于掌握；外部状态独立保存） ──
model ExternalWordMapping {
  id                 String    @id @default(cuid())
  provider           String    @default("TYPEWORDS")
  providerInstanceId String    @default("default")
  externalWordId     String
  itemId             String?
  deckId             String?
  /**
   * 外部应用状态快照（NEW/LEARNING/WRONG/FAVORITE/MASTERED/DUE 等，原样字符串）
   */
  externalState      String?
  externalStateJson  String?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  item VocabularyItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  deck VocabularyDeck? @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@unique([provider, providerInstanceId, externalWordId])
  @@index([itemId])
  @@index([deckId])
}

// ── V6 每日词汇任务（与 PlanTask 同事务关联；词汇时间与总预算共用） ──
model VocabularyAssignment {
  id                 String    @id @default(cuid())
  assignmentDate     String
  budgetMinutes      Int
  reviewTarget       Int       @default(0)
  newTarget          Int       @default(0)
  estimatedMinutes   Int       @default(0)
  /**
   * PLANNED | SENT | IN_PROGRESS | DONE | SKIPPED
   */
  status             String    @default("PLANNED")
  priorityPolicyJson String?
  rationale          String?
  deckId             String?
  planTaskId         String?
  externalDeckId     String?
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deck     VocabularyDeck?             @relation(fields: [deckId], references: [id], onDelete: SetNull)
  planTask PlanTask?                   @relation(fields: [planTaskId], references: [id], onDelete: SetNull)
  items    VocabularyAssignmentItem[]
  sessions VocabularyPracticeSession[]

  @@unique([assignmentDate])
  @@index([status])
  @@index([planTaskId])
}

model VocabularyAssignmentItem {
  id           String   @id @default(cuid())
  assignmentId String
  itemId       String
  /**
   * P0 | P1 | P2 | P3
   */
  priority     String   @default("P1")
  /**
   * REVIEW | NEW | WEAKNESS
   */
  kind         String   @default("NEW")
  /**
   * 建议模式（跟写/听写/自测/默写）
   */
  mode         String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  assignment VocabularyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  item       VocabularyItem       @relation("AssignmentItems", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, itemId])
  @@index([assignmentId, sortOrder])
  @@index([itemId])
}

// ── V7 外部练习会话（幂等键 provider + instance + externalSessionId） ──
model VocabularyPracticeSession {
  id                 String   @id @default(cuid())
  provider           String   @default("TYPEWORDS")
  providerInstanceId String   @default("default")
  externalSessionId  String
  deckExternalId     String?
  /**
   * 源码真实模式；不可用时为 UNAVAILABLE，不伪造 0
   */
  mode               String?
  startedAt          DateTime
  endedAt            DateTime
  durationSeconds    Int
  /**
   * 有效秒数（扣除与既有学习记录重叠的区间）
   */
  effectiveSeconds   Int?
  overlapAdjusted    Boolean  @default(false)
  summaryJson        String?
  correctCount       Int?
  incorrectCount     Int?
  /**
   * SUMMARY_ONLY | ATTEMPT
   */
  granularity        String   @default("SUMMARY_ONLY")
  sourceVersion      String?
  payloadHash        String
  importedAt         DateTime @default(now())
  jobId              String?
  assignmentId       String?
  planTaskId         String?
  studySessionId     String?
  createdAt          DateTime @default(now())

  job          IntegrationJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assignment   VocabularyAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  planTask     PlanTask?             @relation(fields: [planTaskId], references: [id], onDelete: SetNull)
  studySession StudySession?         @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  attempts     VocabularyAttempt[]

  @@unique([provider, providerInstanceId, externalSessionId])
  @@index([startedAt])
  @@index([assignmentId])
  @@index([planTaskId])
  @@index([jobId])
}

// ── V8 逐词尝试（仅当源文件真实提供时写入；summary-only 会话没有 attempt） ──
model VocabularyAttempt {
  id                String    @id @default(cuid())
  sessionId         String
  externalAttemptId String
  externalWordId    String?
  itemId            String?
  occurredAt        DateTime?
  mode              String?
  /**
   * CORRECT | INCORRECT | SKIPPED
   */
  result            String
  latencyMs         Int?
  errorType         String?
  typedInput        String?
  hintUsed          Boolean?
  createdAt         DateTime  @default(now())

  session VocabularyPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    VocabularyItem?           @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([sessionId, externalAttemptId])
  @@index([itemId])
  @@index([result])
}

// ── V9 多维知识状态（每词每维度一行，绝不压成单一分数） ──
model VocabularyKnowledgeState {
  id             String   @id @default(cuid())
  itemId         String
  /**
   * FORM_RECOGNITION | MEANING_RECOGNITION | MEANING_RECALL | SPELLING_RECALL | LISTENING_RECOGNITION | CONTEXT_UNDERSTANDING | PRODUCTIVE_USE
   */
  dimension      String
  /**
   * UNKNOWN | INTRODUCED | RECOGNIZED | RECALLED | CONTEXT_UNDERSTOOD | PRODUCTIVE_USE_VERIFIED
   */
  status         String   @default("UNKNOWN")
  confidence     String   @default("LOW")
  evidenceCount  Int      @default(0)
  lastVerifiedAt String?
  lastEvidenceId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  item VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, dimension])
  @@index([status])
  @@index([lastVerifiedAt])
}

// ── V10 复用 EvidenceRecord 的词汇证据链接（不另建证据表） ──
model VocabularyEvidenceLink {
  id         String   @id @default(cuid())
  evidenceId String   @unique
  itemId     String
  dimension  String
  createdAt  DateTime @default(now())

  evidence EvidenceRecord @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  item     VocabularyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, dimension])
  @@index([evidenceId])
}

// ── V11 外部引擎连接（不保存第三方账号密码） ──
model IntegrationConnection {
  id               String    @id @default(cuid())
  provider         String    @default("TYPEWORDS")
  name             String
  /**
   * FILE | BRIDGE
   */
  mode             String    @default("FILE")
  endpoint         String?
  pinnedVersion    String?
  capabilitiesJson String?
  licenseNote      String?
  enabled          Boolean   @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  jobs IntegrationJob[]

  @@unique([provider, name])
  @@index([enabled])
}

// ── V12 同步任务与审计（原始 payload + hash + 错误报告；可重试） ──
model IntegrationJob {
  id           String    @id @default(cuid())
  connectionId String?
  provider     String    @default("TYPEWORDS")
  /**
   * EXPORT_DECK | IMPORT_BACKUP | IMPORT_SESSION
   */
  direction    String
  /**
   * queued | running | succeeded | partial | failed | retrying
   */
  status       String    @default("queued")
  fileName     String?
  payloadHash  String?
  payloadText  String?
  countsJson   String?
  errorReport  String?
  retryCount   Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  connection IntegrationConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  sessions   VocabularyPracticeSession[]

  @@index([direction, status])
  @@index([payloadHash])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// v2.4 AI Learning Engine（全部为加法；不修改既有学习数据）
// ══════════════════════════════════════════════════════════════════════════════

// ── AI1 模型配置（密钥只来自环境变量，绝不入库） ──
model AIModelConfig {
  id                 String   @id @default(cuid())
  provider           String
  model              String
  label              String
  capabilitiesJson   String?
  active             Boolean  @default(true)
  isDefault          Boolean  @default(false)
  contextWindow      Int?
  inputPricePerMtok  Float    @default(0)
  outputPricePerMtok Float    @default(0)
  parametersJson     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions AILearningSession[]

  @@unique([provider, model])
  @@index([isDefault])
}

// ── AI2 提示词模板与版本（已使用版本不可覆盖，只能追加） ──
model PromptTemplate {
  id        String   @id @default(cuid())
  promptKey String   @unique
  purpose   String
  mode      String
  createdAt DateTime @default(now())

  versions PromptVersion[]
}

model PromptVersion {
  id               String    @id @default(cuid())
  templateId       String
  version          Int
  systemTemplate   String
  userTemplate     String
  inputSchemaJson  String?
  outputSchemaJson String?
  status           String    @default("DRAFT") // DRAFT|PUBLISHED|RETIRED
  testSamplesJson  String?
  checksum         String
  createdBy        String    @default("system")
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  template PromptTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sessions AILearningSession[]
  turns    AILearningTurn[]
  callLogs AICallLog[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

// ── AI3 教学会话（状态机主表） ──
model AILearningSession {
  id                String    @id @default(cuid())
  mode              String
  skill             String
  objective         String
  targetLevel       String?
  status            String    @default("CREATED")
  promptTemplateKey String
  promptVersionId   String?
  modelConfigId     String?
  provider          String
  model             String
  baselineText      String?
  contextJson       String?
  taskSpecJson      String?
  rubricJson        String?
  allowedAidsJson   String?
  directTeaching    Boolean   @default(false)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  pausedAt          DateTime?
  failureReason     String?
  estimatedCostUsd  Float     @default(0)
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  totalLatencyMs    Int       @default(0)
  parentSessionId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  promptVersion PromptVersion?         @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  modelConfig   AIModelConfig?         @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)
  turns         AILearningTurn[]
  tasks         LearningTaskInstance[]
  callLogs      AICallLog[]
  feedback      AISessionFeedback[]
  evidence      EvidenceRecord[]
  parent        AILearningSession?     @relation("AISessionChain", fields: [parentSessionId], references: [id], onDelete: SetNull)
  children      AILearningSession[]    @relation("AISessionChain")

  @@index([status, createdAt])
  @@index([mode])
  @@index([skill])
}

// ── AI4 会话轮次（用户原始答案与 AI 输出按 role/kind 分离） ──
model AILearningTurn {
  id              String   @id @default(cuid())
  sessionId       String
  sequence        Int
  role            String // USER|AI|SYSTEM
  kind            String
  contentText     String
  structuredJson  String?
  aidLevel        String?
  promptVersionId String?
  requestId       String?
  clientRequestId String?
  latencyMs       Int?
  inputTokens     Int?
  outputTokens    Int?
  createdAt       DateTime @default(now())

  session       AILearningSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion?      @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  feedback      AISessionFeedback[]

  @@unique([sessionId, sequence])
  @@unique([sessionId, clientRequestId])
  @@index([sessionId, createdAt])
}

// ── AI5 任务实例（AI 生成的 TaskSpec 落库；建议进入正式计划需用户确认） ──
model LearningTaskInstance {
  id               String   @id @default(cuid())
  sessionId        String?
  linkedPlanTaskId String?
  taskSpecJson     String
  source           String   @default("AI")
  estimatedMinutes Int      @default(10)
  difficulty       String?
  allowedAidsJson  String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session AILearningSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([linkedPlanTaskId])
}

// ── AI6 调用日志（Token/成本/时延/错误；不存密钥与完整提示词） ──
model AICallLog {
  id                   String   @id @default(cuid())
  sessionId            String?
  provider             String
  model                String
  promptVersionId      String?
  requestId            String
  latencyMs            Int
  inputTokens          Int      @default(0)
  outputTokens         Int      @default(0)
  estimatedCostUsd     Float    @default(0)
  status               String // OK|MOCK|ERROR|TIMEOUT|INVALID_OUTPUT|BLOCKED
  errorCode            String?
  redactedMetadataJson String?
  createdAt            DateTime @default(now())

  session       AILearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  promptVersion PromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([sessionId])
}

// ── AI7 用户反馈（有帮助/无帮助/不准确） ──
model AISessionFeedback {
  id          String   @id @default(cuid())
  sessionId   String
  turnId      String?
  helpfulness String // HELPFUL|UNHELPFUL|INACCURATE
  note        String?
  createdAt   DateTime @default(now())

  session AILearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn    AILearningTurn?   @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

// ── AI8 引擎设置（单行；外部 AI 默认关闭） ──
model AIEngineSetting {
  id                    String   @id @default("default")
  externalAiEnabled     Boolean  @default(false)
  dailyBudgetUsd        Float    @default(1)
  monthlyBudgetUsd      Float    @default(20)
  warnPercent           Int      @default(80)
  directTeachingDefault Boolean  @default(false)
  explainLanguage       String   @default("ZH_MIXED")
  updatedAt             DateTime @updatedAt
}
