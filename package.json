{
  "name": "ielts-learning-os",
  "version": "1.0.0",
  "private": true,
  "description": "IELTS Learning OS — 单用户英语学习闭环工作台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backup": "node --test scripts/__tests__/backup-bundle.test.mjs && vitest run src/lib/__tests__/backupRestore.integration.test.ts",
    "test:backup:scripts": "node --test scripts/__tests__/backup-bundle.test.mjs",
    "backup:drill": "node scripts/backup-restore-drill.mjs",
    "test:e2e": "tsx scripts/e2e-v21.mts && tsx scripts/e2e-v22.mts && tsx scripts/e2e-v23.mts && vitest run src/lib/actions/__tests__/tutor.integration.test.ts src/lib/actions/__tests__/diagnostics.integration.test.ts",
    "test:provider:smoke": "tsx scripts/provider-smoke.mts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:install:v271": "tsx scripts/install-v271.mts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && prisma generate && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test:e2e:v21": "tsx scripts/e2e-v21.mts",
    "test:e2e:v22": "tsx scripts/e2e-v22.mts",
    "test:e2e:v23": "tsx scripts/e2e-v23.mts",
    "test:e2e:v24": "vitest run src/lib/actions/__tests__/tutor.integration.test.ts",
    "test:e2e:v241": "vitest run src/lib/actions/__tests__/diagnostics.integration.test.ts"
  },
  "keywords": [
    "ielts",
    "learning",
    "nextjs",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.16.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "6.16.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
